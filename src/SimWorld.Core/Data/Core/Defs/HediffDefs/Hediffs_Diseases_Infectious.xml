<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Diseases the body fights (RimWorld: Hediffs_Diseases_Infectious). Severity climbs until immunity reaches 1,
    then falls; tending slows the climb by severityPerDayTended × tend quality. An untended infection or plague
    outruns immunity; flu does not. WoundInfection is ported from RimWorld's own def; see its comment.
  -->

  <HediffDef Name="DiseaseBase" Abstract="True">
    <hediffClass>SimWorld.Health.Hediff</hediffClass>
    <tendable>true</tendable>
    <makesSickThought>true</makesSickThought>
    <lethalSeverity>1</lethalSeverity>
  </HediffDef>

  <!--
    WoundInfection, ported from RimWorld's own def as the wiki's generated def dump gives it
    (rimworldwiki.com/wiki/Hediffs/Core/Local/Infections). Until lane/downed it was not that def, and the
    difference was what killed people after a raid: this port's "extreme" stage began at 0.62 and took 0.2
    consciousness, its "major" stage 0.05 more, so two or three infections at once summed to a consciousness of
    zero and killed a citizen whose worst infection had not reached 0.8 and whose immunity was nearly won.
    RimWorld's rule is the one the wiki states in words: "If the patient can become immune before their worst
    infection reaches 100%, they have beaten all their infections." Its stages only ever take 0.05 consciousness
    before the last one, and the last one caps consciousness at 0.1 (setMax) rather than subtracting from it, so
    any number of infections downs a pawn but none of them kills until one reaches lethalSeverity.
    Seed 12345, populated, before this change: 4 of the 7 citizens who died of infection after the day-17 raid
    died that way, every infection they carried below 0.8.

    Ported with it, and harsher: RimWorld tends an infection for 12 hours, not 24, and immunity decays at -0.4
    a day once the infection is gone, not -0.3.

    NOT ported, on purpose - immunityPerDaySick. RimWorld's def says 0.6441, but it is multiplied by the
    ImmunityGainSpeed stat, which RimWorld raises x1.10 for a resting pawn and x1.07 more in a standard bed
    (wiki: Immunity_gain_speed). This port has neither stat part, and 0.7 is already 0.6441 x 1.10 to within a
    percent. Porting the number without its multiplier would make this def harsher than RimWorld's rather than
    closer to it; porting the multiplier needs a rule for whether a downed pawn on the ground counts as resting,
    which could not be sourced from here. Recorded rather than guessed.
  -->
  <HediffDef ParentName="DiseaseBase">
    <defName>WoundInfection</defName>
    <label>infection</label>
    <initialSeverity>0.001</initialSeverity>
    <comps>
      <li Class="SimWorld.Health.HediffCompProperties_TendDuration">
        <baseTendDurationHours>12</baseTendDurationHours>
        <severityPerDayTended>-0.53</severityPerDayTended>
      </li>
      <li Class="SimWorld.Health.HediffCompProperties_Immunizable">
        <immunityPerDaySick>0.7</immunityPerDaySick>
        <severityPerDayNotImmune>0.84</severityPerDayNotImmune>
        <immunityPerDayNotSick>-0.4</immunityPerDayNotSick>
        <severityPerDayImmune>-0.7</severityPerDayImmune>
      </li>
    </comps>
    <stages>
      <li>
        <label>minor</label>
        <painOffset>0.05</painOffset>
      </li>
      <li>
        <minSeverity>0.33</minSeverity>
        <label>major</label>
        <painOffset>0.08</painOffset>
      </li>
      <li>
        <minSeverity>0.78</minSeverity>
        <label>extreme</label>
        <lifeThreatening>true</lifeThreatening>
        <painOffset>0.12</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.87</minSeverity>
        <label>extreme</label>
        <lifeThreatening>true</lifeThreatening>
        <painOffset>0.85</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
          <li>
            <capacity>Breathing</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="DiseaseBase">
    <defName>Flu</defName>
    <label>flu</label>
    <initialSeverity>0.1</initialSeverity>
    <comps>
      <li Class="SimWorld.Health.HediffCompProperties_TendDuration">
        <baseTendDurationHours>24</baseTendDurationHours>
        <severityPerDayTended>-0.62</severityPerDayTended>
      </li>
      <li Class="SimWorld.Health.HediffCompProperties_Immunizable">
        <immunityPerDaySick>0.7</immunityPerDaySick>
        <severityPerDayNotImmune>0.5</severityPerDayNotImmune>
        <immunityPerDayNotSick>-0.3</immunityPerDayNotSick>
        <severityPerDayImmune>-0.8</severityPerDayImmune>
      </li>
    </comps>
    <stages>
      <li>
        <label>minor</label>
        <painOffset>0.02</painOffset>
      </li>
      <li>
        <minSeverity>0.4</minSeverity>
        <label>major</label>
        <painOffset>0.05</painOffset>
        <hungerRateFactor>1.2</hungerRateFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.1</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.85</minSeverity>
        <label>extreme</label>
        <lifeThreatening>true</lifeThreatening>
        <painOffset>0.1</painOffset>
        <hungerRateFactor>1.2</hungerRateFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.3</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.2</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="DiseaseBase">
    <defName>Plague</defName>
    <label>plague</label>
    <initialSeverity>0.1</initialSeverity>
    <comps>
      <li Class="SimWorld.Health.HediffCompProperties_TendDuration">
        <baseTendDurationHours>24</baseTendDurationHours>
        <severityPerDayTended>-0.53</severityPerDayTended>
      </li>
      <li Class="SimWorld.Health.HediffCompProperties_Immunizable">
        <immunityPerDaySick>0.62</immunityPerDaySick>
        <severityPerDayNotImmune>0.84</severityPerDayNotImmune>
        <immunityPerDayNotSick>-0.3</immunityPerDayNotSick>
        <severityPerDayImmune>-0.8</severityPerDayImmune>
      </li>
    </comps>
    <stages>
      <li>
        <label>minor</label>
        <painOffset>0.03</painOffset>
      </li>
      <li>
        <minSeverity>0.4</minSeverity>
        <label>major</label>
        <painOffset>0.08</painOffset>
        <restFallFactor>1.2</restFallFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.1</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.8</minSeverity>
        <label>extreme</label>
        <lifeThreatening>true</lifeThreatening>
        <painOffset>0.15</painOffset>
        <restFallFactor>1.2</restFallFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.3</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.3</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>

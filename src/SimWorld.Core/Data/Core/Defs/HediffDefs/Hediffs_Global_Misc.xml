<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Whole-body conditions the health tracker creates itself (RimWorld: Hediffs_Global_Misc). -->

  <!-- Placed on a destroyed part; bleeds until tended, then stays as the record of the loss. -->
  <HediffDef>
    <defName>MissingBodyPart</defName>
    <label>missing body part</label>
    <hediffClass>SimWorld.Health.Hediff_MissingPart</hediffClass>
    <tendable>true</tendable>
    <displayWound>true</displayWound>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="SimWorld.Health.HediffCompProperties_TendDuration" />
    </comps>
    <injuryProps>
      <painPerSeverity>0.0125</painPerSeverity>
      <averagePainPerSeverityPermanent>0</averagePainPerSeverityPermanent>
      <bleedRate>0.06</bleedRate>
    </injuryProps>
  </HediffDef>

  <!-- Accumulates from bleeding at 0.001 per bleed unit per 60 ticks; recovers 0.4/day; lethal at 1. -->
  <HediffDef>
    <defName>BloodLoss</defName>
    <label>blood loss</label>
    <lethalSeverity>1</lethalSeverity>
    <initialSeverity>0.001</initialSeverity>
    <comps>
      <li Class="SimWorld.Health.HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.4</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>minor</label>
        <becomeVisible>false</becomeVisible>
      </li>
      <li>
        <minSeverity>0.15</minSeverity>
        <label>minor</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.3</minSeverity>
        <label>moderate</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.1</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.45</minSeverity>
        <label>severe</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.3</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.3</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.6</minSeverity>
        <label>extreme</label>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!-- Builds 0.113/day while starving and fades at the same pace once fed; lethal at 1. -->
  <HediffDef>
    <defName>Malnutrition</defName>
    <label>malnutrition</label>
    <lethalSeverity>1</lethalSeverity>
    <initialSeverity>0.001</initialSeverity>
    <stages>
      <li>
        <label>trivial</label>
      </li>
      <li>
        <minSeverity>0.2</minSeverity>
        <label>minor</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.03</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.4</minSeverity>
        <label>moderate</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.1</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.1</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.6</minSeverity>
        <label>severe</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.2</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.2</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.1</offset>
          </li>
          <li>
            <capacity>BloodFiltration</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.8</minSeverity>
        <label>extreme</label>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.3</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.5</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.2</offset>
          </li>
          <li>
            <capacity>BloodFiltration</capacity>
            <offset>-0.2</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!-- A basic replacement leg: works at 85% of the natural part (RimWorld: SimpleProstheticLeg). -->
  <HediffDef>
    <defName>SimpleProstheticLeg</defName>
    <label>simple prosthetic leg</label>
    <hediffClass>SimWorld.Health.Hediff_AddedPart</hediffClass>
    <isBad>false</isBad>
    <countsAsAddedPartOrImplant>true</countsAsAddedPartOrImplant>
    <addedPartProps>
      <partEfficiency>0.85</partEfficiency>
      <solid>true</solid>
    </addedPartProps>
  </HediffDef>

</Defs>

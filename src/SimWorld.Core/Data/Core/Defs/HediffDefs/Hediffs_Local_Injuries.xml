  <!-- Skin stays whole: no bleeding, no infection, no scar. -->
  <HediffDef ParentName="InjuryBase">
    <defName>Bruise</defName>
    <label>bruise</label>
    <comps>
      <li Class="SimWorld.Health.HediffCompProperties_TendDuration" />
    </comps>
    <injuryProps>
      <painPerSeverity>0.0125</painPerSeverity>
      <averagePainPerSeverityPermanent>0.00625</averagePainPerSeverityPermanent>
      <bleedRate>0</bleedRate>
      <canMerge>true</canMerge>
      <destroyedLabel>crushed</destroyedLabel>
    </injuryProps>
  </HediffDef>

  <!-- Bone damage: solid parts take cracks instead of cuts. -->
  <HediffDef ParentName="InjuryBase">
    <defName>Crack</defName>
    <label>crack</label>
    <comps>
      <li Class="SimWorld.Health.HediffCompProperties_TendDuration" />
      <li Class="SimWorld.Health.HediffCompProperties_GetsPermanent">
        <permanentLabel>old crack</permanentLabel>
        <becomePermanentChanceFactor>2</becomePermanentChanceFactor>
      </li>
    </comps>
    <injuryProps>
      <painPerSeverity>0.0125</painPerSeverity>
      <averagePainPerSeverityPermanent>0.00625</averagePainPerSeverityPermanent>
      <bleedRate>0.01</bleedRate>
      <canMerge>false</canMerge>

  <HediffDef ParentName="InjuryBase">
    <defName>Crush</defName>
    <label>crush</label>
    <comps>
      <li Class="SimWorld.Health.HediffCompProperties_TendDuration" />
      <li Class="SimWorld.Health.HediffCompProperties_Infecter">
        <infectionChance>0.15</infectionChance>
      </li>

<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Wounds left by damage (RimWorld: Hediffs_Local_Injuries). Severity is the damage amount; pain and bleeding scale with it. -->

  <!--
    infectionChance is RimWorld's own, per the wiki's generated def dump (rimworldwiki.com/wiki/Hediffs/Core/Local/Injuries):
    0.15 for Cut, Scratch, Stab, Gunshot and Crush, 0.30 for Bite and Burn. Until lane/downed these were 0.4 (0.5 for a bite,
    0.3 for a crush), with no source recorded - between two and three times RimWorld's, which after a raid meant more
    infections than a settlement's doctors could win the immunity race on. HediffComp_Infecter applies the chance when its
    timer runs out, scaled down by tend quality; see that class.
  -->

  <HediffDef Name="InjuryBase" Abstract="True">
    <hediffClass>SimWorld.Health.Hediff_Injury</hediffClass>
    <tendable>true</tendable>
    <displayWound>true</displayWound>
    <initialSeverity>1</initialSeverity>
  </HediffDef>

  <HediffDef ParentName="InjuryBase">
    <defName>Cut</defName>
    <label>cut</label>
    <comps>
      <li Class="SimWorld.Health.HediffCompProperties_TendDuration" />
      <li Class="SimWorld.Health.HediffCompProperties_Infecter">
        <infectionChance>0.15</infectionChance>
      </li>
      <li Class="SimWorld.Health.HediffCompProperties_GetsPermanent">
        <permanentLabel>cut scar</permanentLabel>
      </li>
    </comps>
    <injuryProps>
      <painPerSeverity>0.0125</painPerSeverity>
      <averagePainPerSeverityPermanent>0.00625</averagePainPerSeverityPermanent>
      <bleedRate>0.06</bleedRate>
      <canMerge>false</canMerge>
      <destroyedLabel>cut off</destroyedLabel>
    </injuryProps>
  </HediffDef>

  <HediffDef ParentName="InjuryBase">
    <defName>Scratch</defName>
    <label>scratch</label>
    <comps>
      <li Class="SimWorld.Health.HediffCompProperties_TendDuration" />
      <li Class="SimWorld.Health.HediffCompProperties_Infecter">
        <infectionChance>0.15</infectionChance>
      </li>
      <li Class="SimWorld.Health.HediffCompProperties_GetsPermanent">
        <permanentLabel>scratch scar</permanentLabel>
      </li>
    </comps>
    <injuryProps>
      <painPerSeverity>0.0125</painPerSeverity>
      <averagePainPerSeverityPermanent>0.00625</averagePainPerSeverityPermanent>
      <bleedRate>0.04</bleedRate>
      <canMerge>false</canMerge>
      <destroyedLabel>torn off</destroyedLabel>
    </injuryProps>
  </HediffDef>

  <HediffDef ParentName="InjuryBase">
    <defName>Stab</defName>
    <label>stab</label>
    <comps>
      <li Class="SimWorld.Health.HediffCompProperties_TendDuration" />
      <li Class="SimWorld.Health.HediffCompProperties_Infecter">
        <infectionChance>0.15</infectionChance>
      </li>
      <li Class="SimWorld.Health.HediffCompProperties_GetsPermanent">
        <permanentLabel>stab scar</permanentLabel>
      </li>
    </comps>
    <injuryProps>
      <painPerSeverity>0.0125</painPerSeverity>
      <averagePainPerSeverityPermanent>0.00625</averagePainPerSeverityPermanent>
      <bleedRate>0.06</bleedRate>
      <canMerge>false</canMerge>
      <destroyedLabel>cut off</destroyedLabel>
    </injuryProps>
  </HediffDef>

  <HediffDef ParentName="InjuryBase">
    <defName>Bite</defName>
    <label>bite</label>
    <comps>
      <li Class="SimWorld.Health.HediffCompProperties_TendDuration" />
      <li Class="SimWorld.Health.HediffCompProperties_Infecter">
        <infectionChance>0.3</infectionChance>
      </li>
      <li Class="SimWorld.Health.HediffCompProperties_GetsPermanent">
        <permanentLabel>bite scar</permanentLabel>
      </li>
    </comps>
    <injuryProps>
      <painPerSeverity>0.0125</painPerSeverity>
      <averagePainPerSeverityPermanent>0.00625</averagePainPerSeverityPermanent>
      <bleedRate>0.06</bleedRate>
      <canMerge>false</canMerge>
      <destroyedLabel>bitten off</destroyedLabel>
    </injuryProps>
  </HediffDef>

  <HediffDef ParentName="InjuryBase">
    <defName>Gunshot</defName>
    <label>gunshot</label>
    <comps>

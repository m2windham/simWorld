<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Skill-driven stats (system: work.stats). Content for the StatDef.skillNeedOffsets/skillNeedFactors
    pipeline (src/SimWorld.Core/Stats/StatWorker.cs, SkillNeed.cs): a SkillNeed_Direct table looks a value up
    per skill level; a SkillNeed_BaseBonus adds baseValue + bonusPerLevel * level. None of the numbers below
    are RimWorld's own sourced values — this sandbox has no access to RimWorld's real StatDefs_Work.xml, so
    every curve here is this port's own invention, picked only to be monotonic (higher skill never gives a
    worse value) and to land somewhere plausible. Tests pin the trend (skill up -> value up, level 0 -> base),
    never a literal number from these tables, per CLAUDE.md's "say so in a comment" rule.

    MiningSpeed, ConstructionSpeed, CookSpeed and ResearchSpeed are new here (no prior StatDef existed for
    them) — real RimWorld canon names, added because this module's brief names them explicitly as stats that
    "obviously want a skill need". MiningSpeed is read now - AI's JobDriver_Mine turns it into the time
    between pick hits, as RimWorld's does - but Building's JobDriver_ConstructFinishFrame still reads its
    skill level directly and applies its own hand-rolled curve (it says so in its own doc comment, predating
    this module) rather than going through these StatDefs — wiring that up belongs to whichever module owns those job drivers, not
    this one. ConstructionSpeed's own curve (0.4 at level 0, 2.0 at level 20) is deliberately set to the same
    endpoints as JobDriver_ConstructFinishFrame's WorkSpeedFactorFromConstructionLevel for narrative
    consistency, not because the two are wired together.
  -->

  <StatDef>
    <defName>WorkSpeedGlobal</defName>
    <label>work speed</label>
    <description>A general work speed factor that applies to all work.</description>
    <defaultBaseValue>1</defaultBaseValue>
    <minValue>0.1</minValue>
    <!--
      RimWorld's own WorkSpeedGlobal carries no skillNeedFactors at all (only trait/health/capacity effects —
      each specific work type has its own speed stat for that). This module's brief calls for WorkSpeedGlobal
      specifically to demonstrate the pipeline before per-work-type speed stats are read by any job driver;
      Intellectual is an arbitrary "general competence" stand-in with no RimWorld basis, kept deliberately
      small (+/-5% across the whole skill range) precisely because it is not RimWorld-authentic.
    -->
    <skillNeedFactors>
      <li Class="SimWorld.Stats.SkillNeed_BaseBonus">
        <skill>Intellectual</skill>
        <baseValue>0.95</baseValue>
        <bonusPerLevel>0.005</bonusPerLevel>
      </li>
    </skillNeedFactors>
  </StatDef>

  <StatDef>
    <defName>MedicalTendQuality</defName>
    <label>medical tend quality</label>
    <description>How good a job this pawn does when tending wounds and illness.</description>
    <!--
      RimWorld's definition, from its wiki page for the stat (https://rimworldwiki.com/wiki/Medical_tend_quality):
      "20% plus 10% per skill level" on the Medicine skill, Manipulation at 100% importance and Sight at 70%
      (both limited to 140%), and a post-processing curve (0,0) (1,1) (2,1.5) (4,2) that flattens the top: skill 8
      is 100%, skill 10 110%, skill 20 155%, which is exactly the table the page prints. The page is marked as
      needing a rewrite and carries no game version, but its table and its curve agree with each other to the
      digit, which is the check available without the def itself.
      What stood here was a hand-written table that ran 0.30 at skill 0 to 1.00 at skill 20 in steps of 0.035:
      a skill-5 doctor was 0.475 where RimWorld's is 0.70, a skill-10 one 0.65 where it is 1.10. Every tend in
      the game was that much worse, and a tend's quality is what pushes an infection's severity back.
      Base 1: SkillNeed_BaseBonus is multiplicative here (base x factor), as RimWorld's is.
    -->
    <defaultBaseValue>1</defaultBaseValue>
    <minValue>0</minValue>
    <skillNeedFactors>
      <li Class="SimWorld.Stats.SkillNeed_BaseBonus">
        <skill>Medicine</skill>
        <baseValue>0.2</baseValue>
        <bonusPerLevel>0.1</bonusPerLevel>
      </li>
    </skillNeedFactors>
    <capacityFactors>
      <li>
        <capacity>Manipulation</capacity>
        <weight>1</weight>
        <max>1.4</max>
      </li>
      <li>
        <capacity>Sight</capacity>
        <weight>0.7</weight>
        <max>1.4</max>
      </li>
    </capacityFactors>
    <postProcessCurve>
      <points>
        <li>(0, 0)</li>
        <li>(1, 1)</li>
        <li>(2, 1.5)</li>
        <li>(4, 2)</li>
      </points>
    </postProcessCurve>
  </StatDef>

  <StatDef>
    <defName>MiningSpeed</defName>
    <label>mining speed</label>
    <description>How quickly this pawn breaks rock while mining.</description>
    <defaultBaseValue>1</defaultBaseValue>
    <minValue>0.1</minValue>
    <skillNeedFactors>
      <li Class="SimWorld.Stats.SkillNeed_BaseBonus">
        <skill>Mining</skill>
        <baseValue>0.6</baseValue>
        <bonusPerLevel>0.04</bonusPerLevel>
      </li>
    </skillNeedFactors>
  </StatDef>

  <StatDef>
    <defName>ConstructionSpeed</defName>
    <label>construction speed</label>
    <description>How quickly this pawn builds things.</description>
    <defaultBaseValue>1</defaultBaseValue>
    <minValue>0.1</minValue>
    <skillNeedFactors>
      <li Class="SimWorld.Stats.SkillNeed_BaseBonus">
        <skill>Construction</skill>
        <baseValue>0.4</baseValue>
        <bonusPerLevel>0.08</bonusPerLevel>
      </li>
    </skillNeedFactors>
  </StatDef>

  <StatDef>
    <defName>CookSpeed</defName>
    <label>cooking speed</label>
    <description>How quickly this pawn cooks meals.</description>
    <defaultBaseValue>1</defaultBaseValue>
    <minValue>0.1</minValue>
    <skillNeedFactors>
      <li Class="SimWorld.Stats.SkillNeed_BaseBonus">
        <skill>Cooking</skill>
        <baseValue>0.6</baseValue>
        <bonusPerLevel>0.04</bonusPerLevel>
      </li>
    </skillNeedFactors>
  </StatDef>

  <StatDef>
    <defName>ResearchSpeed</defName>
    <label>research speed</label>
    <description>How quickly this pawn generates research points.</description>
    <defaultBaseValue>1</defaultBaseValue>
    <minValue>0.1</minValue>
    <skillNeedFactors>
      <li Class="SimWorld.Stats.SkillNeed_BaseBonus">
        <skill>Intellectual</skill>
        <baseValue>0.4</baseValue>
        <bonusPerLevel>0.08</bonusPerLevel>
      </li>
    </skillNeedFactors>
  </StatDef>

</Defs>

<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Pawn stats the Stats module's pipeline replaces hard-coded Pawn properties with (RimWorld: part of
    Stats_Pawns_General). Every default here is RimWorld's own vanilla base value, not a guess: sourced from
    RimWorld's own core StatDefs content (defaultBaseValue, minValue/maxValue, capacityFactors) rather than
    reverse-engineered from behaviour, since these five are read straight off the pawn with no other module
    reproducing their raw numbers first.
  -->

  <StatDef>
    <defName>RestRateMultiplier</defName>
    <label>rest rate multiplier</label>
    <description>A multiplier on how quickly a pawn rests while sleeping.</description>
    <category>BasicsPawn</category>
    <defaultBaseValue>1</defaultBaseValue>
    <minValue>0.05</minValue>
    <capacityFactors>
      <li>
        <capacity>BloodPumping</capacity>
        <weight>0.3</weight>
      </li>
      <li>
        <capacity>Metabolism</capacity>
        <weight>0.3</weight>
      </li>
      <li>
        <capacity>Breathing</capacity>
        <weight>0.3</weight>
      </li>
    </capacityFactors>
  </StatDef>

  <!--
    Resting and bed factors (task #104), both sourced from the RimWorld wiki's Immunity_gain_speed page and
    the 1.0 decompile's StatPart_Resting/StatPart_BedStat (see those classes' own doc comments for the exact
    reading, including the "a downed pawn on open ground does not count as resting" rule the wiki states in
    words: "Not resting (or downed): x100%"). Not ported: the wiki's further Rest-need-category (tired/very
    tired/exhausted) and hunger-category factors — this port's StatPart_Rest/StatPart_Food equivalents do not
    exist yet, so those two multipliers are left at their RimWorld default of x100% rather than guessed.
  -->
  <StatDef>
    <defName>ImmunityGainSpeed</defName>
    <label>immunity gain speed</label>
    <description>A multiplier on how quickly a sick pawn develops immunity to a disease.</description>
    <category>BasicsPawn</category>
    <defaultBaseValue>1</defaultBaseValue>
    <minValue>0</minValue>
    <parts>
      <li Class="SimWorld.Stats.StatPart_Resting">
        <factor>1.10</factor>
      </li>
      <li Class="SimWorld.Stats.StatPart_BedStat">
        <stat>BedRestEffectiveness</stat>
      </li>
    </parts>
  </StatDef>

  <StatDef>
    <defName>PainShockThreshold</defName>
    <label>pain shock threshold</label>
    <description>How much pain a pawn can handle before collapsing.</description>
    <category>BasicsPawn</category>
    <defaultBaseValue>0.8</defaultBaseValue>
    <maxValue>0.99</maxValue>
  </StatDef>

  <StatDef>
    <defName>GlobalLearningFactor</defName>
    <label>global learning factor</label>
    <description>A multiplier on passive, learning-by-doing skill experience gain.</description>
    <category>BasicsPawn</category>
    <defaultBaseValue>1</defaultBaseValue>
  </StatDef>

  <StatDef>
    <defName>MentalBreakThreshold</defName>
    <label>mental break threshold</label>
    <description>As long as a pawn's mood is below this level, they are in danger of having a mental break.</description>
    <category>BasicsPawn</category>
    <defaultBaseValue>0.35</defaultBaseValue>
    <minValue>0.01</minValue>
  </StatDef>

  <!--
    Added with the AI module (system 9): Pawn_PathFollower reads this to convert one cell of movement into
    ticks. 4.6 is RimWorld's own vanilla base human move speed (cells/second). No capacityFactors yet:
    RimWorld's real stat likely bends this with the Moving capacity (a limping pawn should walk slower), but
    the exact weight isn't sourced and nothing in this pass depends on it, so it is left a flat per-race
    value rather than guessed.
  -->
  <StatDef>
    <defName>MoveSpeed</defName>
    <label>move speed</label>
    <description>How many cells a pawn crosses per second while walking.</description>
    <category>BasicsPawn</category>
    <defaultBaseValue>4.6</defaultBaseValue>
    <minValue>0.1</minValue>
  </StatDef>

</Defs>

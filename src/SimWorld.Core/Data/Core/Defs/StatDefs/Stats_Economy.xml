<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Economy pricing (RimWorld: StatDefs). TradeUtility reads MarketValue off a ThingDef's statBases to
    price it; a ThingDef that sets none prices at 0 (this stat's own defaultBaseValue), not some silently
    assumed value.

    The StatPart_Quality curve below is this pass's own (stats.stuff-quality-parts): not RimWorld's exact
    per-tier multipliers, only shaped the same way — Awful worth a fraction of Normal, Legendary worth
    several times it. Only fires for a Thing that actually carries a CompQuality (apparel, prosthetics);
    everything else's MarketValue is untouched, curve.Evaluate(3)=1 at Normal either way.
  -->

  <StatDef>
    <defName>MarketValue</defName>
    <label>market value</label>
    <defaultBaseValue>0</defaultBaseValue>
    <minValue>0</minValue>
    <parts>
      <li Class="SimWorld.Stats.StatPart_Quality">
        <curve>
          <points>
            <li>(0, 0.35)</li>
            <li>(1, 0.6)</li>
            <li>(2, 1)</li>
            <li>(3, 1.35)</li>
            <li>(4, 1.75)</li>
            <li>(5, 2.5)</li>
            <li>(6, 5)</li>
          </points>
        </curve>
      </li>
    </parts>
  </StatDef>

</Defs>

<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Apparel (pawngen.apparel): ThingDef.apparel (body part groups + layers + tags) is Things' addition — see
    ThingDef.Apparel.cs — consumed the same way ThingDef.weaponTags/generateCommonality already are:
    PawnApparelGenerator matches a PawnKindDef's apparelTags against these, prices against MarketValue within
    the kind's apparelMoneyRange, and gates on techLevel against the generated pawn's faction, exactly like
    PawnWeaponGenerator. Prices are this pass's own — not sourced from RimWorld's real apparel costs — picked
    only to order sensibly relative to each other and to the weapon prices Weapons_Melee.xml already uses.

    ArmorRating_*/Insulation statBases are the first wearers those StatDefs have ever had (Stats_Armor.xml /
    StatDefs_Things.xml). Every entry here carries hasQuality + CompProperties_Quality so
    Stats_Economy.xml's new StatPart_Quality actually has something to multiply, and stuffCategories so the
    stuff factor/offset half of the stat pipeline (StatWorker's own remarks) has something made-from-stuff to
    read once a real Thing exists with a Stuff set.
  -->

  <ThingDef Name="BaseApparel" Abstract="True">
    <category>Item</category>
    <thingClass>SimWorld.Things.ThingWithComps</thingClass>
    <stackLimit>1</stackLimit>
    <thingCategories><li>Manufactured</li></thingCategories>
    <hasQuality>true</hasQuality>
    <comps>
      <li Class="SimWorld.Things.CompProperties_Quality" />
    </comps>
  </ThingDef>

  <ThingDef ParentName="BaseApparel">
    <defName>Apparel_Shirt</defName>
    <label>shirt</label>
    <description>A simple shirt. Everyone owns one.</description>
    <techLevel>Neolithic</techLevel>
    <stuffCategories>
      <li>Fabric</li>
    </stuffCategories>
    <statBases>
      <MarketValue>8</MarketValue>
      <ArmorRating_Sharp>0.02</ArmorRating_Sharp>
      <Insulation>0.08</Insulation>
    </statBases>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
      </bodyPartGroups>
      <layers>
        <li>OnSkin</li>
      </layers>
      <tags>
        <li>Civil</li>
        <li>Tribal</li>
        <li>Soldier</li>
      </tags>
    </apparel>
  </ThingDef>


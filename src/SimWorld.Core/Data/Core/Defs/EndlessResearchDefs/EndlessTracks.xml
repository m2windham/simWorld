      <li>alloy</li>
      <li>ceramic</li>
      <li>colloid</li>
      <li>crystal</li>
      <li>polymer</li>
      <li>aerogel</li>
      <li>filament</li>
      <li>glass</li>
      <li>weave</li>
    </substrates>
    <foundationForms>
      <li>theory</li>
      <li>synthesis</li>
      <li>first principles</li>
      <li>formalism</li>
      <li>unification</li>
      <li>taxonomy</li>
    </foundationForms>
    <appliedForms>

<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Making medicine (system: health, item health.medicalresearch). Own file, per CLAUDE.md.

    RimWorld's Make_MedicineIndustrial (Core Recipes_Production / DrugLab, research MedicineProduction) takes one
    herbal medicine, one neutroamine and three cloth, as recalled and not checked against the file from here.
    This port has no neutroamine and a settlement only weaves cloth once a citizen lacks a shirt, so the
    translation is two herbal doses distilled into one: the healroot a settlement already grows is the input,
    and what changes with Pharmacology is what it can turn it into (potency 0.6 and quality cap 0.7 for herbal,
    1.0 and 1.0 for this). workAmount is this port's own.
  -->

  <RecipeDef>
    <defName>Make_MedicineIndustrial</defName>
    <researchPrerequisites>
      <li>Pharmacology</li>
    </researchPrerequisites>
    <label>prepare medicine</label>
    <jobString>Preparing medicine.</jobString>
    <workAmount>700</workAmount>
    <workSkill>Intellectual</workSkill>
    <ingredients>
      <li>
        <filter><thingDefs><li>MedicineHerbal</li></thingDefs></filter>
        <count>2</count>
      </li>
    </ingredients>
    <products><MedicineIndustrial>1</MedicineIndustrial></products>
    <recipeUsers><li>DrugLab</li></recipeUsers>
  </RecipeDef>

</Defs>

<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Surgeries: recipes performed on a pawn rather than at a workbench. isSurgery routes them to a
    Bill_Medical on the patient's own bill stack (Pawn_HealthTracker.surgeryBills) instead of a workbench's,
    and workerClass carries what the operation actually does — a thing "consume these, produce those" cannot
    express.

    surgerySuccessChanceFactor and deathOnFailedSurgeryChance are SimWorld's own numbers, not sourced from
    RimWorld: amputation is crude and forgiving, cutting an infection out of a living body is neither. The
    tests pin the trend (a better surgeon fails less often; a lower factor fails more often) rather than
    these literals.

    InstallSimpleProstheticLeg (health.prosthetic-items) is the recipe this file used to hold back: the
    SimpleProstheticLeg hediff and Recipe_InstallBodyPart both already existed, but a prosthetic is an *item*
    a civilization has to make or buy, and no such ThingDef existed. Items_Prosthetics.xml is that item now,
    and ingredients here names it — SurgeryUtility.PerformNextSurgery only fires this bill when a matching
    Thing is passed in as an ingredient on hand, so it can no longer hand one out for free. Every surgery
    above still consumes nothing, unchanged: RecipeDef.ConfigErrors only requires ingredients/products of a
    non-surgery recipe, and installs are the one surgery content actually gives one.
  -->

  <RecipeDef>
    <defName>RemoveBodyPart</defName>
    <label>amputate part</label>
    <description>Cut off a body part. The oldest operation there is, and the one least likely to go wrong.</description>
    <jobString>Amputating.</jobString>
    <isSurgery>true</isSurgery>
    <targetsBodyPart>true</targetsBodyPart>
    <workerClass>SimWorld.Health.Recipe_RemoveBodyPart</workerClass>
    <workAmount>2000</workAmount>
    <workSkill>Medicine</workSkill>
    <surgerySuccessChanceFactor>1.0</surgerySuccessChanceFactor>
    <deathOnFailedSurgeryChance>0.02</deathOnFailedSurgeryChance>
  </RecipeDef>

  <RecipeDef>
    <defName>ExciseInfection</defName>
    <label>excise infection</label>
    <description>Cut an infection out of a wound before immunity loses the race to it.</description>
    <jobString>Excising infection.</jobString>
    <isSurgery>true</isSurgery>
    <targetsBodyPart>true</targetsBodyPart>
    <workerClass>SimWorld.Health.Recipe_RemoveHediff</workerClass>
    <removesHediff>WoundInfection</removesHediff>
    <workAmount>2500</workAmount>
    <workSkill>Medicine</workSkill>
    <skillRequirements>
      <li><skill>Medicine</skill><minLevel>4</minLevel></li>
    </skillRequirements>
    <surgerySuccessChanceFactor>0.8</surgerySuccessChanceFactor>
    <deathOnFailedSurgeryChance>0.05</deathOnFailedSurgeryChance>
  </RecipeDef>

  <RecipeDef>
    <defName>InstallSimpleProstheticLeg</defName>
    <label>install simple prosthetic leg</label>
    <description>Fit a simple mechanical leg in place of a missing or ruined one.</description>
    <jobString>Installing simple prosthetic leg.</jobString>
    <isSurgery>true</isSurgery>
    <targetsBodyPart>true</targetsBodyPart>
    <workerClass>SimWorld.Health.Recipe_InstallBodyPart</workerClass>
    <addsHediff>SimpleProstheticLeg</addsHediff>
    <appliedOnFixedBodyParts>
      <li>Leg</li>
    </appliedOnFixedBodyParts>
    <ingredients>
      <li>
        <filter>
          <thingDefs><li>SimpleProstheticLeg</li></thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <workAmount>3000</workAmount>
    <workSkill>Medicine</workSkill>
    <skillRequirements>
      <li><skill>Medicine</skill><minLevel>5</minLevel></li>
    </skillRequirements>
    <surgerySuccessChanceFactor>0.9</surgerySuccessChanceFactor>
    <deathOnFailedSurgeryChance>0.02</deathOnFailedSurgeryChance>
  </RecipeDef>

</Defs>

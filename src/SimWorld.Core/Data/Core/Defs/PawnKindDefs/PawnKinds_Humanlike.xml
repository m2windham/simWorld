<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <PawnKindDef>
    <defName>Colonist</defName>
    <label>colonist</label>
    <race>Human</race>
    <backstoryCategories>
      <li>Civil</li>
    </backstoryCategories>
    <combatPower>60</combatPower>
    <isFighter>true</isFighter>
    <apparelTags>
      <li>Civil</li>
    </apparelTags>
    <apparelMoneyRange>0~50</apparelMoneyRange>
  </PawnKindDef>

  <PawnKindDef>
    <defName>Villager</defName>
    <label>villager</label>
    <race>Human</race>
    <backstoryCategories>
      <li>Civil</li>
    </backstoryCategories>
    <combatPower>40</combatPower>
    <!--
      Who a kind is, said in traits (SimWorld's own; RimWorld constrains its own kinds this way but these
      particular choices are not ported from any vanilla PawnKindDef).

      Villagers are the settled civilians a world generates by the hundred and nobody chose: the two traits
      that make a person a standing danger to the settlement around them are not rolled for that population.
      Colonist, deliberately, carries no such list — the player's founding colonists draw from the whole pool,
      psychopaths included, and that contrast is the point. A kind with no forcedTraits/disallowedTraits is
      saying something, not forgetting something.
    -->
    <disallowedTraits>
      <li>Psychopath</li>
      <li>Pyromaniac</li>
    </disallowedTraits>
    <apparelTags>
      <li>Civil</li>
    </apparelTags>
    <apparelMoneyRange>0~30</apparelMoneyRange>
  </PawnKindDef>

  <PawnKindDef>
    <defName>Tribesperson</defName>
    <label>tribesperson</label>
    <race>Human</race>
    <backstoryCategories>
      <li>Tribal</li>
    </backstoryCategories>
    <combatPower>50</combatPower>
    <isFighter>true</isFighter>
    <!-- SettlementFounder generates every founding citizen as a Tribesperson, and this kind carried no
         weaponTags at all — so PawnWeaponGenerator returned early for all of them and no citizen anywhere
         in a generated game held a weapon. That made the Hunt work giver permanently dormant: it requires a
         ranged weapon, as RimWorld's HasHuntingWeapon does. The work type was wired and could never fire.

         A hunting band carries bows. Both tags are listed rather than Neolithic alone because
         PawnWeaponGenerator already caps candidates at ThingDef.techLevel <= faction.def.techLevel, so one
         kind covers a civilization at any rung of the ladder without a second PawnKindDef — RimWorld's own
         mechanism for keeping a neolithic faction off assault rifles. The budget stops short of one (350):
         these are hunters, not soldiers. -->
    <weaponTags>
      <li>NeolithicRangedWeapon</li>
      <li>IndustrialRangedWeapon</li>
    </weaponTags>
    <weaponMoneyRange>0~200</weaponMoneyRange>
    <apparelTags>
      <li>Tribal</li>
    </apparelTags>
    <apparelMoneyRange>0~40</apparelMoneyRange>
  </PawnKindDef>

  <PawnKindDef>
    <defName>Drifter</defName>
    <label>drifter</label>
    <race>Human</race>
    <backstoryCategories>
      <li>Civil</li>
      <li>Tribal</li>
    </backstoryCategories>
    <combatPower>45</combatPower>
    <apparelTags>
      <li>Civil</li>
      <li>Tribal</li>
    </apparelTags>
    <apparelMoneyRange>0~35</apparelMoneyRange>
  </PawnKindDef>

  <!--
    Raid squad kinds (director.raids / pawngen.gear). combatPower is SimWorld's own — picked to sit near the
    existing Colonist(60)/Tribesperson(50) scale rather than sourced from RimWorld's real raider numbers —
    pinned by PawnGroupMakerTests as a trend (a bigger points budget fields a bigger/stronger squad), not a
    literal. weaponMoneyRange/weaponTags feed PawnWeaponGenerator; apparelMoneyRange/apparelTags feed
    PawnApparelGenerator the same way (pawngen.apparel) — see Weapons_Melee.xml's and Apparel_Basic.xml's top
    comments.
  -->

  <PawnKindDef>
    <defName>Raider_Melee</defName>
    <label>raider</label>
    <race>Human</race>
    <backstoryCategories>
      <li>Tribal</li>
    </backstoryCategories>
    <combatPower>35</combatPower>
    <isFighter>true</isFighter>
    <!--
      A raider who closes to blade range is a brawler; that is the whole of this kind's role. Forced traits
      are granted before the random roll and count against the pawn's two-or-three trait budget, so this kind
      rolls one fewer trait than an unconstrained one — intended, and the mechanism RimWorld uses too.

      The grant is not unconditional: PawnGenerator refuses a forced trait the pawn cannot meet the
      requiredWorkTags of, and Brawler requires Violent. A raider whose Tribal adulthood came up "tribal
      elder" (workDisables Violent) therefore gets no Brawler — and PawnGroupMaker, which is the only thing
      that makes raiders for real, asks for mustBeCapableOfViolence and discards that pawn anyway.
    -->
    <forcedTraits>
      <li>
        <def>Brawler</def>
        <degree>0</degree>
      </li>
    </forcedTraits>
    <weaponTags>
      <li>NeolithicMeleeWeapon</li>
    </weaponTags>
    <weaponMoneyRange>0~100</weaponMoneyRange>
    <apparelTags>
      <li>Tribal</li>
    </apparelTags>
    <apparelMoneyRange>0~40</apparelMoneyRange>
  </PawnKindDef>

  <PawnKindDef>
    <defName>Raider_Bow</defName>
    <label>raider archer</label>
    <race>Human</race>
    <backstoryCategories>
      <li>Tribal</li>
    </backstoryCategories>
    <combatPower>45</combatPower>
    <isFighter>true</isFighter>
    <!-- The mirror of Raider_Melee: a brawler wants nothing to do with a bow. RimWorld enforces the same
         pairing from the weapon side (its PawnWeaponGenerator will not hand a Brawler a ranged weapon, a rule
         this port has not yet ported); saying it here keeps the ranged raider kinds coherent whichever side
         lands first, and a raider archer is never generated wishing it were somewhere else. -->
    <disallowedTraits>
      <li>Brawler</li>
    </disallowedTraits>
    <weaponTags>
      <li>NeolithicRangedWeapon</li>
    </weaponTags>
    <weaponMoneyRange>0~150</weaponMoneyRange>
    <apparelTags>
      <li>Tribal</li>
    </apparelTags>
    <apparelMoneyRange>0~40</apparelMoneyRange>
  </PawnKindDef>

  <PawnKindDef>
    <defName>Raider_Gunner</defName>
    <label>raider gunner</label>
    <race>Human</race>
    <backstoryCategories>
      <li>Civil</li>
    </backstoryCategories>
    <combatPower>70</combatPower>
    <isFighter>true</isFighter>
    <!-- As Raider_Bow. -->
    <disallowedTraits>
      <li>Brawler</li>
    </disallowedTraits>
    <weaponTags>
      <li>IndustrialRangedWeapon</li>
    </weaponTags>
    <weaponMoneyRange>100~400</weaponMoneyRange>
    <apparelTags>
      <li>Soldier</li>
    </apparelTags>
    <apparelMoneyRange>0~400</apparelMoneyRange>
  </PawnKindDef>

</Defs>

<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    World generation pipeline (RimWorld: WorldGenStepDefs), run in ascending order by WorldGenerator.
    Regions runs after Rivers because region edges read biome/elevation/river data; Deposits runs after
    Regions because it aggregates per-tile deposits into each region's resource profile. Roads runs after
    Factions because it connects settlements the Factions step places. Factions itself is excluded from
    regeneration-on-load: settlements/factions are saved directly instead of being recomputed from the seed
    (see World.RegenerateGrid) — every other step stays included, since each needs only the
    already-regenerated terrain (and, for Roads, the already-loaded settlements) and uses no randomness
    that would disagree with the original generation (Deposits uses none at all; Regions reseeds its own
    stream from the world seed exactly like every other step).
  -->

  <WorldGenStepDef>
    <defName>Terrain</defName>
    <order>100</order>
    <workerClass>SimWorld.World.Gen.WorldGenStep_Terrain</workerClass>
  </WorldGenStepDef>

  <WorldGenStepDef>
    <defName>Biomes</defName>
    <order>200</order>
    <workerClass>SimWorld.World.Gen.WorldGenStep_Biomes</workerClass>
  </WorldGenStepDef>

  <WorldGenStepDef>
    <defName>Rivers</defName>
    <order>300</order>
    <workerClass>SimWorld.World.Gen.WorldGenStep_Rivers</workerClass>
  </WorldGenStepDef>

  <WorldGenStepDef>
    <defName>Regions</defName>
    <order>320</order>
    <workerClass>SimWorld.World.Gen.WorldGenStep_Regions</workerClass>
  </WorldGenStepDef>

  <WorldGenStepDef>
    <defName>Deposits</defName>
    <order>340</order>
    <workerClass>SimWorld.World.Gen.WorldGenStep_Deposits</workerClass>
  </WorldGenStepDef>

  <WorldGenStepDef>
    <defName>Factions</defName>
    <order>400</order>
    <workerClass>SimWorld.World.Gen.WorldGenStep_Factions</workerClass>
    <regenerateOnLoad>false</regenerateOnLoad>
  </WorldGenStepDef>

  <WorldGenStepDef>
    <defName>Roads</defName>
    <order>500</order>
    <workerClass>SimWorld.World.Gen.WorldGenStep_Roads</workerClass>
  </WorldGenStepDef>

</Defs>

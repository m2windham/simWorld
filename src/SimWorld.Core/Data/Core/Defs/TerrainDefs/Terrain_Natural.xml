<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Fertility is RimWorld's, 1:1, from rimworldwiki.com/wiki/Terrain: soil 100%, rich soil 140%,
    marshy soil 100%, stony soil (RimWorld's defName Gravel) 70%, sand 10%, marsh, mud, ice and all water 0%.
    These were this port's own scale before (soil 1.4, rich 2.8, gravel 0, sand 0.6, marshy 1.1, marsh 0.9),
    which put RimWorld's sourced crop gates out of reach: healroot needs 0.7 and could not grow on stony
    ground at all.
  -->

  <TerrainDef>
    <defName>Soil</defName>
    <label>soil</label>
    <pathCost>0</pathCost>
    <fertility>1.0</fertility>
    <layerable>true</layerable>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>GrowSoil</li>
      <li>Diggable</li>
    </affordances>
  </TerrainDef>

  <TerrainDef>
    <defName>SoilRich</defName>
    <label>rich soil</label>
    <pathCost>0</pathCost>
    <fertility>1.4</fertility>
    <layerable>true</layerable>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>GrowSoil</li>
      <li>Diggable</li>
    </affordances>
  </TerrainDef>

  <TerrainDef>
    <defName>Gravel</defName>
    <label>gravel</label>
    <pathCost>0</pathCost>
    <fertility>0.7</fertility>
    <layerable>true</layerable>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>Diggable</li>
    </affordances>
  </TerrainDef>

  <TerrainDef>
    <defName>Sand</defName>
    <label>sand</label>
    <pathCost>0</pathCost>
    <fertility>0.1</fertility>
    <layerable>true</layerable>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>GrowSoil</li>
      <li>Diggable</li>
    </affordances>
  </TerrainDef>

  <TerrainDef>
    <defName>MarshyTerrain</defName>
    <label>marshy soil</label>
    <pathCost>4</pathCost>
    <fertility>1.0</fertility>
    <takeFootprints>true</takeFootprints>
    <affordances>
      <li>Light</li>
      <li>GrowSoil</li>
    </affordances>
  </TerrainDef>

  <TerrainDef>
    <defName>Mud</defName>
    <label>mud</label>
    <pathCost>3</pathCost>
    <fertility>0</fertility>
    <takeFootprints>true</takeFootprints>
    <affordances>
      <li>Light</li>
    </affordances>
  </TerrainDef>

  <TerrainDef>
    <defName>WaterShallow</defName>
    <label>shallow water</label>
    <pathCost>30</pathCost>
    <fertility>0</fertility>
    <passability>Standable</passability>
    <water>true</water>
    <affordances>
      <li>Bridgeable</li>
    </affordances>
  </TerrainDef>

  <TerrainDef>
    <defName>WaterDeep</defName>
    <label>deep water</label>
    <fertility>0</fertility>
    <passability>Impassable</passability>
    <water>true</water>
    <affordances>
      <li>Bridgeable</li>
    </affordances>
  </TerrainDef>

  <TerrainDef>
    <defName>WaterMovingShallow</defName>
    <label>shallow moving water</label>
    <pathCost>40</pathCost>
    <fertility>0</fertility>
    <passability>Standable</passability>
    <water>true</water>
    <affordances>
      <li>Bridgeable</li>
    </affordances>
  </TerrainDef>

  <TerrainDef>
    <defName>WaterMovingChestDeep</defName>
    <label>chest-deep moving water</label>
    <fertility>0</fertility>
    <passability>Impassable</passability>
    <water>true</water>
    <affordances>
      <li>Bridgeable</li>
    </affordances>
  </TerrainDef>

  <TerrainDef>
    <defName>Ice</defName>
    <label>ice</label>
    <pathCost>1</pathCost>
    <fertility>0</fertility>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
    </affordances>
  </TerrainDef>

  <TerrainDef>
    <defName>Marsh</defName>
    <label>marsh</label>
    <pathCost>6</pathCost>
    <fertility>0</fertility>
    <takeFootprints>true</takeFootprints>
    <affordances>
      <li>Light</li>
    </affordances>
  </TerrainDef>

</Defs>

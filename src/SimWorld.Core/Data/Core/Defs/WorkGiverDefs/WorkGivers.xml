<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- A representative RimWorld work-giver set. giverClass is left to its code default (WorkGiver_Pending) —
       scanning the map for jobs lands with the job system (system 9). -->

  <WorkGiverDef>
    <defName>FightFires</defName>
    <label>fight fires</label>
    <verb>Fight fire</verb>
    <gerund>fighting fire</gerund>
    <workType>Firefighter</workType>
    <priorityInType>100</priorityInType>
    <emergency>true</emergency>
    <!-- Wired to a real scanner (system: fire). Until this pass there was no Fire class in the codebase at
         all, so this def had no worker and nothing it could ever have targeted. -->
    <giverClass>SimWorld.AI.WorkGiver_FightFires</giverClass>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>DoctorTendEmergency</defName>
    <label>tend patients (emergency)</label>
    <verb>Tend</verb>
    <gerund>tending to</gerund>
    <workType>Doctor</workType>
    <priorityInType>100</priorityInType>
    <emergency>true</emergency>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <!-- Wired to a real scanner (system: health — tending): WorkGiver_Tend also backs the ordinary
         DoctorTend below it; this def's own <emergency> flag is what tells the two apart, read via
         TendUtility.NeedsEmergencyTend (bleeding or life-threatening) — see that class's own doc. -->
    <giverClass>SimWorld.AI.WorkGiver_Tend</giverClass>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>DoctorTend</defName>
    <label>tend patients</label>
    <verb>Tend</verb>
    <gerund>tending to</gerund>
    <workType>Doctor</workType>
    <priorityInType>90</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <!-- Same WorkGiver_Tend class as DoctorTendEmergency above — see that def's own comment. -->
    <giverClass>SimWorld.AI.WorkGiver_Tend</giverClass>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>DoctorFeedHumanlikes</defName>
    <label>feed patients</label>
    <verb>Feed</verb>
    <gerund>feeding</gerund>
    <workType>Doctor</workType>
    <priorityInType>80</priorityInType>
    <!-- requiredCapacities added for consistency with the other three Doctor givers in this file (carrying
         food to a patient needs working hands too); not independently re-verified against a live RimWorld
         dump for this specific def. -->
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <!-- Wired to a real scanner (system: health — tending): finds a downed, hungry, non-prisoner humanlike
         of the doctor's own faction and reuses WardenFeed's own JobDef/JobDriver unchanged — see
         WorkGiver_FeedPatient's own doc for why this collapses onto that one mechanism instead of copying
         it, and for why WardenDeliverFood below stays unwired. -->
    <giverClass>SimWorld.AI.WorkGiver_FeedPatient</giverClass>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>DoctorRescue</defName>
    <label>rescue downed pawns</label>
    <verb>Rescue</verb>
    <gerund>rescuing</gerund>
    <workType>Doctor</workType>
    <priorityInType>70</priorityInType>
    <!-- See DoctorFeedHumanlikes' own comment on requiredCapacities above — carrying a downed patient needs
         working hands the same way. -->
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <!-- Wired to a real scanner (system: health — tending): finds a downed patient of the rescuer's own
         faction (or a prisoner it holds) and carries them to RestUtility.FindBedFor's nearest reachable bed
         — see WorkGiver_RescueDowned's own doc for what happens with no bed on the map at all. -->
    <giverClass>SimWorld.AI.WorkGiver_RescueDowned</giverClass>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>WardenFeed</defName>
    <label>feed prisoners</label>
    <verb>Feed</verb>
    <gerund>feeding</gerund>
    <workType>Warden</workType>
    <priorityInType>100</priorityInType>
    <!-- Wired to a real scanner with the capture loop (system 12: Factions — capture): feeds a downed
         prisoner directly, standing in for RimWorld's own "in bed and needs medical rest" trigger — see
         WorkGiver_Warden_Feed's own doc. -->
    <giverClass>SimWorld.AI.WorkGiver_Warden_Feed</giverClass>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>WardenAttemptRecruit</defName>
    <label>recruit prisoners</label>
    <verb>Talk with prisoner</verb>
    <gerund>talking with prisoner</gerund>
    <workType>Warden</workType>
    <priorityInType>80</priorityInType>
    <!-- Wired to a real scanner with the capture loop (system 12: Factions — capture): the missing other
         half of Pawn_GuestTracker.cs's WardenUtility.TryInteract, which a prior pass left implemented but
         uncalled by anything except a test. See WorkGiver_Warden_AttemptRecruit's own doc for why this
         WorkGiverDef itself (unlike PrisonerAttemptRecruit, the JobDef) has no RimWorld-sourced name to
         port 1:1: RimWorld reaches this interaction through its social-interaction scheduler, which this
         codebase does not have, so the scan is this port's own translation onto the WorkGiver shape every
         other Warden task here already uses. -->
    <giverClass>SimWorld.AI.WorkGiver_Warden_AttemptRecruit</giverClass>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>WardenDeliverFood</defName>
    <label>deliver food to prisoners</label>
    <verb>Deliver food</verb>
    <gerund>delivering food</gerund>
    <workType>Warden</workType>
    <priorityInType>90</priorityInType>
    <!-- Stays WorkGiver_Pending, deliberately: RimWorld's own WorkGiver_Warden_DeliverFood exists for a
         prisoner capable of self-service but with no food reachable in its own room — a distinction this
         port cannot draw (no room/prison-cell system). Here, a prisoner that is not Downed already reaches
         food entirely on its own through the ordinary JobGiver_GetFood tier of its think tree (nothing in
         this port's job selection checks guest status or faction at all), so there is no ambulatory-prisoner
         case left uncovered for this giver to fill — see WorkGiver_Warden_Feed's own doc and this module's
         report. Still true now that DoctorFeedHumanlikes (system: health — tending) is wired alongside it:
         that giver explicitly excludes prisoners (WardenFeed's own patient), so it neither fills this gap nor
         needs this def to fill one of its own — see WorkGiver_FeedPatient's own doc. -->
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>TrainAnimals</defName>
    <label>train animals</label>
    <verb>Train</verb>
    <gerund>training</gerund>
    <workType>Handling</workType>
    <priorityInType>100</priorityInType>
    <!-- Wired to a real scanner with system: ai.animals. -->
    <giverClass>SimWorld.AI.WorkGiver_TrainAnimals</giverClass>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>TameAnimals</defName>
    <label>tame animals</label>
    <verb>Tame</verb>
    <gerund>taming</gerund>
    <workType>Handling</workType>
    <priorityInType>80</priorityInType>
    <giverClass>SimWorld.AI.WorkGiver_TameAnimals</giverClass>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>CookMeals</defName>
    <label>cook meals</label>
    <verb>Cook</verb>
    <gerund>cooking</gerund>
    <workType>Cooking</workType>
    <priorityInType>100</priorityInType>
    <!-- Wired to a real scanner (system: crafting.workbenches — bills at a workbench): works the first
         runnable bill on any spawned bench whose CompProperties_BillGiver.workType matches this giver's own
         workType (FueledStove, for this one) — see WorkGiver_DoBill's own doc for why one class serves this
         and the four DoBills* givers below instead of five near-copies. -->
    <giverClass>SimWorld.Crafting.WorkGiver_DoBill</giverClass>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>Hunt</defName>
    <label>hunt</label>
    <verb>Hunt</verb>
    <gerund>hunting</gerund>
    <workType>Hunting</workType>
    <priorityInType>100</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <!-- Wired to a real scanner (system 9: AI — hunting): a hunter with a ranged weapon shoots a wild animal,
         then butchers it where it fell. RimWorld's WorkGiver_HunterHunt scans for a player-painted
         Designation.Hunt and this codebase has no Designation system at all, so what decides which animals
         get shot is AI.HuntingInitiative — the settlement hunts while short of food and stops when it is not,
         the same "no player designation exists, so the settlement decides for itself" shape
         Building.SettlementConstructionInitiative established. See that class's own doc for why counting only
         Settlement.Stores would leave the gate permanently open, and JobDriver_Hunt's for why the kill is
         butchered at the site (there is no Corpse Thing in this port to haul). -->
    <giverClass>SimWorld.AI.WorkGiver_Hunt</giverClass>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>Repair</defName>
    <label>repair</label>
    <verb>Repair</verb>
    <gerund>repairing</gerund>
    <workType>Construction</workType>
    <!-- Below the three Construct* givers below (95/90/85), not above them at the 100 this placeholder
         carried while it was inert. Finishing what the settlement decided it needs comes before patching up
         what it already has, and here that is not a nicety: without a faction to scan by (see below) this
         giver also finds every weathered ruin wall MapGen.GenStep_Ruins scattered across a generated map,
         each hundreds of hit points short of whole. At 100 those ruins monopolise every builder from the
         first tick and nothing new ever gets built — a real regression this pass's own test run caught in
         ConstructionInitiativeTests. Like the sibling numbers around it, this is SimWorld's own figure, not
         a sourced RimWorld one; what it claims is only the ordering. -->
    <priorityInType>80</priorityInType>
    <!-- Wired to a real scanner (system: work — the Construction work type's maintenance half): finds a
         damaged artificial building and restores its HitPoints a point at a time. RimWorld scans the pawn's
         own faction's repairable buildings; nothing here has a faction to scan by (this port's Thing carries
         no faction field at all), so the predicate is "damaged, not natural rock" instead — the same shape
         Mine's own giver used when it translated designations away and mined any reachable mineable edifice.
         See WorkGiver_Repair's own doc for that translation, and for what in this codebase can damage a
         building in the first place. -->
    <giverClass>SimWorld.AI.WorkGiver_Repair</giverClass>
  </WorkGiverDef>

  <!-- Wired to real scanners with system 16 (Building). Repair, once a placeholder listed here as out of
       scope, now has a real giver of its own above. -->

  <WorkGiverDef>
    <defName>ConstructFinishFrames</defName>
    <label>finish frames</label>
    <verb>Finish</verb>
    <gerund>finishing</gerund>
    <workType>Construction</workType>
    <priorityInType>95</priorityInType>
    <giverClass>SimWorld.Building.WorkGiver_ConstructFinishFrame</giverClass>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>ConstructDeliverResourcesToFrames</defName>
    <label>haul resources to frames</label>
    <verb>Haul resources</verb>
    <gerund>hauling resources</gerund>
    <workType>Construction</workType>
    <priorityInType>90</priorityInType>
    <giverClass>SimWorld.Building.WorkGiver_ConstructDeliverResourcesToFrames</giverClass>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>ConstructDeliverResourcesToBlueprints</defName>
    <label>haul resources to blueprints</label>
    <verb>Haul resources</verb>
    <gerund>hauling resources</gerund>
    <workType>Construction</workType>
    <priorityInType>85</priorityInType>
    <giverClass>SimWorld.Building.WorkGiver_ConstructDeliverResourcesToBlueprints</giverClass>
  </WorkGiverDef>

  <!-- Wired to real scanners with system 16 (Building) — plant growth. -->

  <WorkGiverDef>
    <defName>GrowerHarvest</defName>
    <label>harvest</label>
    <verb>Harvest</verb>
    <gerund>harvesting</gerund>
    <workType>Growing</workType>
    <priorityInType>100</priorityInType>
    <giverClass>SimWorld.Building.WorkGiver_GrowerHarvest</giverClass>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>GrowerSow</defName>
    <label>sow</label>
    <verb>Sow</verb>
    <gerund>sowing</gerund>
    <workType>Growing</workType>
    <priorityInType>90</priorityInType>
    <giverClass>SimWorld.Building.WorkGiver_GrowerSow</giverClass>
    <scanCells>true</scanCells>
    <scanThings>false</scanThings>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>Mine</defName>
    <label>mine</label>
    <verb>Mine</verb>
    <gerund>mining</gerund>
    <workType>Mining</workType>
    <priorityInType>100</priorityInType>
    <!-- The one WorkGiverDef this pass wires to a real scanner (system 9: AI) — proof that JobGiver_Work's
         scan-by-priority actually drives a WorkGiver_Scanner end to end. Every other giver above keeps the
         WorkGiver_Pending default; JobGiver_Work simply finds no job from those and moves on. -->
    <giverClass>SimWorld.AI.WorkGiver_Miner</giverClass>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>PlantsCut</defName>
    <label>cut plants</label>
    <verb>Cut</verb>
    <gerund>cutting</gerund>
    <workType>PlantCutting</workType>
    <priorityInType>100</priorityInType>
    <!-- Wired to a real scanner (system: work — the PlantCutting work type): clears a plant that is in
         something's way. RimWorld drives this from cut/harvest designations, which do not exist anywhere in
         this codebase, so the two reasons the settlement can derive for itself stand in: a plant blocking a
         growing zone's own crop, and a plant standing where a Blueprint or Frame is going up. Both are cases
         RimWorld really does cut for — see WorkGiver_PlantsCut's own doc for where it reaches each of them
         from, and why neither is already served here. -->
    <giverClass>SimWorld.AI.WorkGiver_PlantsCut</giverClass>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>DoBillsSmith</defName>
    <label>smith bills</label>
    <verb>Smith</verb>
    <gerund>smithing</gerund>
    <workType>Smithing</workType>
    <priorityInType>100</priorityInType>
    <!-- Wired to a real scanner (system: crafting.workbenches — bills at a workbench): see CookMeals above. -->
    <giverClass>SimWorld.Crafting.WorkGiver_DoBill</giverClass>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>DoBillsTailor</defName>
    <label>tailor bills</label>
    <verb>Tailor</verb>
    <gerund>tailoring</gerund>
    <workType>Tailoring</workType>
    <priorityInType>100</priorityInType>
    <!-- Wired to a real scanner (system: crafting.workbenches — bills at a workbench): see CookMeals above. -->
    <giverClass>SimWorld.Crafting.WorkGiver_DoBill</giverClass>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>DoBillsArt</defName>
    <label>art bills</label>
    <verb>Make art</verb>
    <gerund>making art</gerund>
    <workType>Art</workType>
    <priorityInType>100</priorityInType>
    <!-- Wired to a real scanner (system: crafting.workbenches — bills at a workbench): see CookMeals above.
         No bench ships yet for this work type — see Buildings_Production.xml's own remarks — so this giver
         currently finds nothing to work; the mechanism is in place for whenever an Art bench/recipe lands. -->
    <giverClass>SimWorld.Crafting.WorkGiver_DoBill</giverClass>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>DoBillsCraft</defName>
    <label>craft bills</label>
    <verb>Craft</verb>
    <gerund>crafting</gerund>
    <workType>Crafting</workType>
    <priorityInType>100</priorityInType>
    <!-- Wired to a real scanner (system: crafting.workbenches — bills at a workbench): see CookMeals above. -->
    <giverClass>SimWorld.Crafting.WorkGiver_DoBill</giverClass>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>HaulGeneral</defName>
    <label>haul</label>
    <verb>Haul</verb>
    <gerund>hauling</gerund>
    <workType>Hauling</workType>
    <priorityInType>100</priorityInType>
    <!-- Wired to a real scanner (system 9: AI — hauling): carries any not-yet-stored haulable item to the
         nearest Zone_Stockpile cell with room for it. See WorkGiver_Haul/HaulAIUtility's own docs for what
         "haulable" and "nowhere to put it" mean in this port. -->
    <giverClass>SimWorld.AI.WorkGiver_Haul</giverClass>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>HaulCorpses</defName>
    <label>haul corpses</label>
    <verb>Haul</verb>
    <gerund>hauling</gerund>
    <workType>Hauling</workType>
    <!-- Above HaulGeneral (100), not below it as this placeholder sat while it was inert. A corpse is an
         ordinary haulable Item in this port, so HaulGeneral would find one too; the point of a separate
         giver — RimWorld ships one for the same reason — is that bodies are cleared before loose clutter.
         Wired to a real scanner (system: corpses): Things.Corpse exists now, which is the only thing this
         def was ever waiting for. See WorkGiver_HaulCorpses's own doc. -->
    <priorityInType>110</priorityInType>
    <giverClass>SimWorld.AI.WorkGiver_HaulCorpses</giverClass>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>CleanFilth</defName>
    <label>clean filth</label>
    <verb>Clean</verb>
    <gerund>cleaning</gerund>
    <workType>Cleaning</workType>
    <priorityInType>100</priorityInType>
    <!-- Wired to a real scanner (system: filth). Before this there was no Filth class in the codebase at
         all, so the whole Cleaning work type had nothing it could ever target. See WorkGiver_CleanFilth
         for the scan and CleaningBounds for what stops cleaning running forever. -->
    <giverClass>SimWorld.Filth.WorkGiver_CleanFilth</giverClass>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>Research</defName>
    <label>research</label>
    <verb>Research</verb>
    <gerund>researching</gerund>
    <workType>Research</workType>
    <priorityInType>100</priorityInType>
    <!-- Wired to a real scanner (system: Research work): a pawn walks to a ResearchBench and advances
         Find.ResearchManager.CurrentProj there. See WorkGiver_Research's own doc for why a bench is
         required — matching RimWorld — and JobDriver_Research's for how points-per-tick is computed. -->
    <giverClass>SimWorld.AI.WorkGiver_Research</giverClass>
  </WorkGiverDef>

</Defs>

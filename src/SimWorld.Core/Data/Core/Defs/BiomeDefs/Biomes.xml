<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Climate zones (RimWorld: BiomeDefs). WorldGenStep_Biomes gives each tile the biome whose workerClass
    scores it highest; every land worker first checks Tile.WaterCovered (so land and water biomes never
    compete), and every water worker checks the opposite. Density/disease/movement numbers below are this
    port's own RimWorld-like approximations, not RimWorld's exact decompiled values.
  -->

  <BiomeDef>
    <defName>Ocean</defName>
    <label>ocean</label>
    <workerClass>SimWorld.World.BiomeWorker_Ocean</workerClass>
    <impassable>true</impassable>
    <canBuildBase>false</canBuildBase>
    <canAutoChoose>false</canAutoChoose>
    <allowRoads>false</allowRoads>
    <allowRivers>false</allowRivers>
    <animalDensity>0</animalDensity>
    <plantDensity>0</plantDensity>
    <settlementSelectionWeight>0</settlementSelectionWeight>
  </BiomeDef>


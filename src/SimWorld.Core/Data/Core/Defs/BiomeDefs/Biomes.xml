<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Climate zones (RimWorld: BiomeDefs). WorldGenStep_Biomes gives each tile the biome whose workerClass
    scores it highest; every land worker first checks Tile.WaterCovered (so land and water biomes never
    compete), and every water worker checks the opposite. Density/disease/movement numbers below are this
    port's own RimWorld-like approximations, not RimWorld's exact decompiled values.

    terrainsByFertility (RimWorld: BiomeDef.terrainsByFertility, read by GenStep_Terrain) is in RimWorld's
    raw-noise fertility units, about -1..1; GenStep_Terrain maps this port's 0..1 grid back to them. What is
    recalled from RimWorld and what is not:
      - The forest and wetland biomes' Soil below 0.87, SoilRich above it: recalled as RimWorld's
        TemperateForest table, and used for every biome whose own table was not recalled differently. The
        wetlands' marsh comes from tile swampiness in GenStep_Terrain, standing in for RimWorld's
        terrainPatchMakers, which are not ported.
      - Ice everywhere on SeaIce and IceSheet, and Sand everywhere on ExtremeDesert: recalled in shape.
      - Tundra, AridShrubland and Desert bands: this port's own, ordered as RimWorld's are (barest ground at
        the lowest fertility), with the cut points chosen, not sourced. Pinned by MapGen tests as shares of
        a map, not as these literals.
    Ocean and Lake carry none: no settlement map is generated on them.
  -->

  <BiomeDef>
    <defName>Ocean</defName>
    <label>ocean</label>
    <workerClass>SimWorld.World.BiomeWorker_Ocean</workerClass>
    <impassable>true</impassable>
    <canBuildBase>false</canBuildBase>
    <canAutoChoose>false</canAutoChoose>
    <allowRoads>false</allowRoads>
    <allowRivers>false</allowRivers>
    <animalDensity>0</animalDensity>
    <plantDensity>0</plantDensity>
    <settlementSelectionWeight>0</settlementSelectionWeight>

<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- The 12 core skills (RimWorld: SkillDefs). Shooting and Melee are barred outright by the Violent work
       tag; every other skill is disabled only when every work type it feeds into is disabled.
       Labels are simWorld's own (player-names3, 2026-11-25): RimWorld's twelve-skill list read as borrowed, so
       each skill is named for the work it serves (building, farming, husbandry match the work columns) and the
       host groups them. defNames stay; saves store defNames. Mining and cooking keep their plain names. -->

  <SkillDef>
    <defName>Shooting</defName>
    <label>marksmanship</label>
    <skillLabel>marksmanship</skillLabel>
    <pawnLabel>Marksman</pawnLabel>
    <listOrder>0</listOrder>
    <disablingWorkTags>Violent</disablingWorkTags>
  </SkillDef>

  <SkillDef>
    <defName>Melee</defName>
    <label>close fighting</label>
    <skillLabel>close fighting</skillLabel>
    <pawnLabel>Fighter</pawnLabel>
    <listOrder>100</listOrder>
    <disablingWorkTags>Violent</disablingWorkTags>
  </SkillDef>

  <SkillDef>
    <defName>Construction</defName>
    <label>building</label>
    <skillLabel>building</skillLabel>
    <pawnLabel>Builder</pawnLabel>
    <listOrder>200</listOrder>
  </SkillDef>

  <SkillDef>
    <defName>Mining</defName>
    <label>mining</label>
    <skillLabel>mining</skillLabel>
    <pawnLabel>Miner</pawnLabel>
    <listOrder>300</listOrder>
  </SkillDef>

  <SkillDef>
    <defName>Cooking</defName>
    <label>cooking</label>
    <skillLabel>cooking</skillLabel>
    <pawnLabel>Cook</pawnLabel>

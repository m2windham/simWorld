<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Raw crafting resources (RimWorld: ThingDefs_Items/Items_Resource). Stuff-capable resources (wood,
    steel, cloth, stone blocks) double as building materials once Buildings model stuff selection.
    thingClass is set explicitly on all four (it wasn't before system 16: Building) — the same latent gap
    already caught and fixed below for the Chunk* defs: nothing constructed one of these as a live Thing
    before something actually hauled it, so the gap sat uncaught until construction needed to spawn and
    haul real WoodLog/Steel stacks. See this module's report.
  -->

  <ThingDef>
    <defName>WoodLog</defName>
    <label>wood</label>
    <description>A stack of logs harvested from a tree.</description>
    <category>Item</category>
    <thingClass>SimWorld.Things.Thing</thingClass>
    <thingCategories><li>ResourcesRaw</li></thingCategories>
    <stackLimit>75</stackLimit>
    <statBases><MarketValue>1.2</MarketValue></statBases>
    <stuffProps>
      <categories><li>Woody</li></categories>
      <commonality>1.2</commonality>
    </stuffProps>
  </ThingDef>

  <ThingDef>
    <defName>Steel</defName>
    <label>steel</label>
    <description>An alloy of iron and other metals, used for most basic construction and crafting.</description>
    <category>Item</category>
    <thingClass>SimWorld.Things.Thing</thingClass>
    <thingCategories><li>ResourcesRaw</li><li>Metals</li></thingCategories>
    <stackLimit>75</stackLimit>
    <statBases><MarketValue>1.9</MarketValue></statBases>
    <stuffProps>
      <categories><li>Metallic</li></categories>
      <commonality>1</commonality>
    </stuffProps>
  </ThingDef>

  <ThingDef>
    <defName>Cloth</defName>
    <label>cloth</label>
    <description>A woven fabric made from plant fibers.</description>
    <category>Item</category>
    <thingClass>SimWorld.Things.Thing</thingClass>
    <thingCategories><li>Textiles</li></thingCategories>
    <stackLimit>100</stackLimit>
    <statBases><MarketValue>1.5</MarketValue></statBases>
    <stuffProps>
      <categories><li>Fabric</li></categories>
      <commonality>1</commonality>
    </stuffProps>
  </ThingDef>

  <ThingDef>
    <defName>BlocksSandstone</defName>
    <label>sandstone blocks</label>
    <description>Sandstone cut into blocks, ready for construction.</description>
    <category>Item</category>
    <thingClass>SimWorld.Things.Thing</thingClass>
    <thingCategories><li>StoneBlocks</li></thingCategories>
    <stackLimit>75</stackLimit>
    <statBases><MarketValue>0.9</MarketValue></statBases>
    <stuffProps>
      <categories><li>Stony</li></categories>
      <commonality>1</commonality>
    </stuffProps>
  </ThingDef>

  <!--
    Loose rock chunks (RimWorld: ThingDefs_Items/Items_Resource "Chunk*"), one per natural rock type, scattered
    onto a generated map by MapGen.GenStep_Scatterers. thingClass is set explicitly here (it wasn't before)
    since ThingMaker.MakeThing needs a concrete runtime type to instantiate; nothing constructed one of these
    before MapGen landed, so the gap was latent rather than caught by a test.
  -->

  <ThingDef>
    <defName>ChunkSandstone</defName>
    <label>chunk of sandstone</label>
    <description>A chunk of sandstone, ready to be cut into blocks at a stonecutter's table.</description>
    <category>Item</category>
    <thingClass>SimWorld.Things.Thing</thingClass>
    <thingCategories><li>ResourcesRaw</li></thingCategories>
    <stackLimit>25</stackLimit>
    <statBases><MarketValue>0</MarketValue></statBases>
  </ThingDef>

  <ThingDef>
    <defName>ChunkGranite</defName>
    <label>chunk of granite</label>
    <description>A chunk of granite, ready to be cut into blocks at a stonecutter's table.</description>
    <category>Item</category>
    <thingClass>SimWorld.Things.Thing</thingClass>
    <thingCategories><li>ResourcesRaw</li></thingCategories>
    <stackLimit>25</stackLimit>
    <statBases><MarketValue>0</MarketValue></statBases>
  </ThingDef>

  <ThingDef>
    <defName>ChunkLimestone</defName>
    <label>chunk of limestone</label>
    <description>A chunk of limestone, ready to be cut into blocks at a stonecutter's table.</description>
    <category>Item</category>
    <thingClass>SimWorld.Things.Thing</thingClass>
    <thingCategories><li>ResourcesRaw</li></thingCategories>
    <stackLimit>25</stackLimit>
    <statBases><MarketValue>0</MarketValue></statBases>
  </ThingDef>

</Defs>

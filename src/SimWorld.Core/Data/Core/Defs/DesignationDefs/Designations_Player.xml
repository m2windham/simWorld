<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    The rest of RimWorld's Designations.xml that this port has a worker for, placed by the player through
    SimWorld.Map.View.MapCommands.Designate (Mine, in Designations.xml, is placed by a settlement as well).
    All aim at a Thing, as RimWorld's do. Forbid/Unforbid are left out: there is no CompForbiddable here.
    Labels are simWorld's own (player-names3): plain verbs where they are honest (harvest, hunt, tame,
    slaughter), and "clear growth", "take down" and "carry first" where RimWorld's designator labels read as its
    UI. The JobDefs and WorkGiverDefs that share these defNames carry the same words.
  -->

  <DesignationDef>
    <defName>CutPlant</defName>
    <label>clear growth</label>
    <targetType>Thing</targetType>
  </DesignationDef>

  <DesignationDef>
    <defName>HarvestPlant</defName>
    <label>harvest</label>
    <targetType>Thing</targetType>
  </DesignationDef>

  <DesignationDef>
    <defName>Hunt</defName>
    <label>hunt</label>
    <targetType>Thing</targetType>
  </DesignationDef>

  <DesignationDef>
    <defName>Tame</defName>
    <label>tame</label>
    <targetType>Thing</targetType>
  </DesignationDef>

  <DesignationDef>
    <defName>Slaughter</defName>
    <label>slaughter</label>
    <targetType>Thing</targetType>
  </DesignationDef>

  <DesignationDef>
    <defName>Deconstruct</defName>
    <label>take down</label>
    <targetType>Thing</targetType>
  </DesignationDef>

  <DesignationDef>
    <defName>HaulUrgently</defName>
    <label>carry first</label>
    <targetType>Thing</targetType>
  </DesignationDef>

</Defs>

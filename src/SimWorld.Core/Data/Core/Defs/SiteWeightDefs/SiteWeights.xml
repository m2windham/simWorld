<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Era-weighted site-scoring advantages (spec §5b.2), one SiteWeightDef per EraDef on the ladder already
    authored in Data/Core/Defs/EraDefs/Eras.xml. RimWorld has nothing to source these numbers from; every
    weight here is this port's own judgement call, shaped to read the way the spec itself describes each
    age ("a neolithic founding reads water, game and flint... an industrial one reads coal and navigable
    water") rather than tuned against any real data. SiteScorer.NecessityMultiplier (fresh water, food,
    survivable climate) is NOT era-weighted — only these advantage weights are.
  -->

  <SiteWeightDef>
    <defName>SiteWeights_SticksAndStones</defName>
    <era>SticksAndStones</era>
    <depositWeights>
      <li><deposit>FreshWater</deposit><weight>3.0</weight></li>
      <li><deposit>Game</deposit><weight>3.0</weight></li>
      <li><deposit>Flint</deposit><weight>2.0</weight></li>
      <li><deposit>Timber</deposit><weight>1.5</weight></li>
      <li><deposit>ArableSoil</deposit><weight>0.5</weight></li>
      <li><deposit>Clay</deposit><weight>0.3</weight></li>
      <li><deposit>Stone</deposit><weight>0.3</weight></li>
      <li><deposit>Ford</deposit><weight>0.3</weight></li>
      <li><deposit>Salt</deposit><weight>0.5</weight></li>
      <li><deposit>DefensibleGround</deposit><weight>0.2</weight></li>
      <li><deposit>Ore</deposit><weight>0.0</weight></li>
    </depositWeights>
    <tradePositionWeight>0.1</tradePositionWeight>
  </SiteWeightDef>


<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef Name="BasePawn" Abstract="True">
    <category>Pawn</category>
    <tickerType>Normal</tickerType>
    <thingClass>SimWorld.Pawns.Pawn</thingClass>
  </ThingDef>

  <ThingDef ParentName="BasePawn">
    <defName>Human</defName>
    <label>human</label>
    <description>A member of the species Homo sapiens.</description>
    <race>
      <intelligence>Humanlike</intelligence>
      <body>Human</body>
      <baseHealthScale>1</baseHealthScale>
      <baseBodySize>1</baseBodySize>
      <baseHungerRate>1</baseHungerRate>
      <foodLevelPercentageWantEat>0.3</foodLevelPercentageWantEat>
      <needsRest>true</needsRest>
      <isFlesh>true</isFlesh>
      <lifeExpectancy>80</lifeExpectancy>
      <mentalBreakThreshold>0.35</mentalBreakThreshold>
    </race>
  </ThingDef>

</Defs>

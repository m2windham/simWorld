<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef Name="BasePawn" Abstract="True">
    <category>Pawn</category>
    <tickerType>Normal</tickerType>
    <thingClass>SimWorld.Pawns.Pawn</thingClass>
  </ThingDef>

  <ThingDef ParentName="BasePawn">
    <defName>Human</defName>
    <label>human</label>
    <description>A member of the species Homo sapiens.</description>
    <statBases>
      <!-- The stats module's own default already matches this; set explicitly so a future non-Human
           statBases override reads as deliberate, not an oversight. -->
      <MentalBreakThreshold>0.35</MentalBreakThreshold>
    </statBases>
    <race>
      <intelligence>Humanlike</intelligence>
      <body>Human</body>
      <baseHealthScale>1</baseHealthScale>
      <baseBodySize>1</baseBodySize>
      <baseHungerRate>1</baseHungerRate>
      <foodLevelPercentageWantEat>0.3</foodLevelPercentageWantEat>
      <needsRest>true</needsRest>
      <isFlesh>true</isFlesh>
      <lifeExpectancy>80</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>HumanlikeBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>HumanlikeChild</def>
          <minAge>3</minAge>
        </li>
        <li>
          <def>HumanlikeTeenager</def>
          <minAge>13</minAge>
        </li>
        <li>
          <def>HumanlikeAdult</def>
          <minAge>18</minAge>
        </li>
      </lifeStageAges>
      <ageGenerationCurve>
        <points>
          <li>(14, 0)</li>
          <li>(16, 100)</li>
          <li>(20, 100)</li>
          <li>(30, 100)</li>
          <li>(50, 30)</li>
          <li>(60, 10)</li>
          <li>(65, 3)</li>
          <li>(70, 1)</li>
          <li>(80, 0)</li>
        </points>
      </ageGenerationCurve>
    </race>
  </ThingDef>

</Defs>

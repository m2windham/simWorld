<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Three hand-authored quest scripts (RimWorld: QuestScriptDef), picked and generated by
    IncidentWorker_GiveQuest. Each root is a small QuestNode tree built with SimWorld's compact node set
    (Sequence/Set/Letter/Delay/GiveReward/End) rather than RimWorld's full QuestGen library.
  -->

  <QuestScriptDef>
    <defName>Quest_Tribute</defName>
    <label>tribute demand</label>
    <description>A rival civilization demands tribute or threatens reprisal.</description>
    <nameTemplate>Tribute demand</nameTemplate>
    <rootSelectionWeight>1.0</rootSelectionWeight>
    <rootMinPoints>0</rootMinPoints>
    <rootMaxPoints>99999</rootMaxPoints>
    <minRefireDays>10</minRefireDays>
    <expireDaysRange>4~8</expireDaysRange>
    <autoAccept>false</autoAccept>
    <!--
      This script used to set demandSilver, send the letter, wait out the offer and end Fail — always.
      Nothing read demandSilver, no coin moved either way, and refusing cost nothing, so "or threatens
      reprisal" in the description above was a sentence with no mechanism behind it. QuestNode_Tribute is
      that mechanism: the demand is answered at the moment the offer would have lapsed, out of the same seat
      a quest reward is paid into, and the two answers end the quest differently.

      goodwillOnPayment is 0 on purpose: protection money buys the absence of a reprisal, not a friendship.
      Both goodwill figures are this port's own — RimWorld has no tribute quest to source them from (see
      QuestPart_Tribute's translation note) — so the tests pin the ordering and the direction, never these
      literals.
    -->
    <root Class="SimWorld.Quests.QuestNode_Sequence">
      <nodes>
        <li Class="SimWorld.Quests.QuestNode_Set">
          <name>demandSilver</name>
          <valueRef>points</valueRef>
        </li>
        <li Class="SimWorld.Quests.QuestNode_Letter">
          <letterDef>ThreatSmall</letterDef>
          <label>Tribute demanded</label>
          <text>A rival civilization demands tribute.</text>
        </li>
        <li Class="SimWorld.Quests.QuestNode_Delay">
          <delayTicksRef>expireTicks</delayTicksRef>
          <node Class="SimWorld.Quests.QuestNode_Tribute">
            <silverRef>demandSilver</silverRef>
            <factionDefName>OutlanderCivilization</factionDefName>
            <goodwillOnPayment>0</goodwillOnPayment>
            <goodwillOnRefusal>-15</goodwillOnRefusal>
            <paidNode Class="SimWorld.Quests.QuestNode_Sequence">
              <nodes>
                <li Class="SimWorld.Quests.QuestNode_Letter">
                  <letterDef>NeutralEvent</letterDef>
                  <label>Tribute paid</label>
                  <text>The tribute was handed over. The threat passes.</text>
                </li>
                <li Class="SimWorld.Quests.QuestNode_End">
                  <outcome>Success</outcome>
                </li>
              </nodes>
            </paidNode>
            <refusedNode Class="SimWorld.Quests.QuestNode_Sequence">
              <nodes>
                <li Class="SimWorld.Quests.QuestNode_Letter">
                  <letterDef>ThreatSmall</letterDef>
                  <label>Tribute refused</label>
                  <text>The demand went unmet. The rival takes it badly.</text>
                </li>
                <li Class="SimWorld.Quests.QuestNode_End">
                  <outcome>Fail</outcome>
                </li>
              </nodes>
            </refusedNode>
          </node>
        </li>
      </nodes>
    </root>
  </QuestScriptDef>

  <QuestScriptDef>
    <defName>Quest_LostCaravan</defName>
    <label>lost caravan</label>
    <description>A caravan lost on the road offers a reward for its rescue.</description>
    <nameTemplate>Lost caravan</nameTemplate>
    <rootSelectionWeight>1.0</rootSelectionWeight>
    <rootMinPoints>0</rootMinPoints>
    <rootMaxPoints>99999</rootMaxPoints>
    <minRefireDays>6</minRefireDays>
    <expireDaysRange>2~5</expireDaysRange>
    <autoAccept>false</autoAccept>
    <root Class="SimWorld.Quests.QuestNode_Sequence">
      <nodes>
        <li Class="SimWorld.Quests.QuestNode_Delay">
          <delayTicksRef>expireTicks</delayTicksRef>
          <node Class="SimWorld.Quests.QuestNode_Sequence">
            <nodes>
              <li Class="SimWorld.Quests.QuestNode_GiveReward">
                <silverAmount>200</silverAmount>
                <goodwillAmount>5</goodwillAmount>
                <goodwillFactionDefName>OutlanderCivilization</goodwillFactionDefName>
              </li>
              <li Class="SimWorld.Quests.QuestNode_End">
                <outcome>Success</outcome>
              </li>
            </nodes>
          </node>
        </li>
      </nodes>
    </root>
  </QuestScriptDef>

  <QuestScriptDef>
    <defName>Quest_Omen</defName>
    <label>omen</label>
    <description>The chronicle records a strange omen.</description>
    <nameTemplate>An omen</nameTemplate>
    <rootSelectionWeight>0.2</rootSelectionWeight>
    <rootMinPoints>0</rootMinPoints>
    <rootMaxPoints>50</rootMaxPoints>
    <minRefireDays>15</minRefireDays>
    <expireDaysRange>2~4</expireDaysRange>
    <autoAccept>true</autoAccept>
    <root Class="SimWorld.Quests.QuestNode_Sequence">
      <nodes>
        <li Class="SimWorld.Quests.QuestNode_Letter">
          <letterDef>NeutralEvent</letterDef>
          <label>An omen</label>
          <text>The chronicle records a strange omen.</text>
        </li>
        <li Class="SimWorld.Quests.QuestNode_Delay">
          <delayTicksRef>expireTicks</delayTicksRef>
          <node Class="SimWorld.Quests.QuestNode_End">
            <outcome>Success</outcome>
          </node>
        </li>
      </nodes>
    </root>
  </QuestScriptDef>

</Defs>

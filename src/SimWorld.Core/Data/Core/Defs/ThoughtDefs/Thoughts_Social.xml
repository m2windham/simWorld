<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Social memories about a specific other pawn (RimWorld's social thought stack), gained by
       SimWorld.Social's InteractionWorkers. "Insulted" reuses Thoughts_Memories.xml's existing thought
       rather than duplicating it here. -->

  <ThoughtDef>
    <defName>HadChitchat</defName>
    <durationDays>0.25</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>2</stackLimitForSameOtherPawn>
    <stages>
      <li>
        <label>had a nice chat</label>
        <description>We chatted for a bit. Pleasant enough.</description>
        <baseMoodEffect>2</baseMoodEffect>
        <baseOpinionOffset>2</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>HadDeepTalk</defName>
    <durationDays>1.5</durationDays>
    <stackLimit>2</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages>
      <li>
        <label>had a deep talk</label>
        <description>We really talked. I feel closer to them.</description>
        <baseMoodEffect>5</baseMoodEffect>
        <baseOpinionOffset>6</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>WasSlighted</defName>
    <durationDays>0.5</durationDays>
    <stackLimit>4</stackLimit>
    <stackLimitForSameOtherPawn>2</stackLimitForSameOtherPawn>
    <stages>
      <li>
        <label>was slighted</label>
        <description>That was a bit rude.</description>
        <baseMoodEffect>-2</baseMoodEffect>
        <baseOpinionOffset>-3</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Situational, not memories: active for as long as the underlying stored relation holds, not gained/lost
       as a one-off event the way the memories above are. Substitutes for RimWorld's spatial "a friend is
       nearby"/"a rival is present" thoughts — no Map/room concept reaches this module yet (see
       SocialInteractionManager's own note) — so "present in this pawn's life" reads as "has a stored direct
       relation of this kind with someone" rather than "in the same room". One generic worker
       (ThoughtWorker_HasDirectRelation) drives both; a future relation kind (Lover, say) only needs another
       ThoughtDef here, no new C#. -->

  <ThoughtDef>
    <defName>HasFriend</defName>
    <workerClass>SimWorld.Thoughts.ThoughtWorker_HasDirectRelation</workerClass>
    <requiredDirectRelation>Friend</requiredDirectRelation>
    <stages>
      <li>
        <label>has a friend</label>
        <description>I have someone here I can call a friend.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>HasRival</defName>
    <workerClass>SimWorld.Thoughts.ThoughtWorker_HasDirectRelation</workerClass>
    <requiredDirectRelation>Rival</requiredDirectRelation>
    <stages>
      <li>
        <label>has a rival</label>
        <description>Someone here rubs me the wrong way, and it isn't going away.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Romance (social.romance): what courtship and its ending leave behind. -->

  <ThoughtDef>
    <defName>BecameLovers</defName>
    <durationDays>15</durationDays>
    <stackLimit>1</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages>
      <li>
        <label>new lover</label>
        <description>We're together. Everything is a little brighter.</description>
        <baseMoodEffect>12</baseMoodEffect>
        <baseOpinionOffset>8</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>RebuffedMyRomanceAttempt</defName>
    <durationDays>4</durationDays>
    <stackLimit>2</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages>
      <li>
        <label>rebuffed</label>
        <description>I asked, and they said no.</description>
        <baseMoodEffect>-8</baseMoodEffect>
        <baseOpinionOffset>-5</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>FailedRomanceAttemptOnMe</defName>
    <durationDays>4</durationDays>
    <stackLimit>2</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages>
      <li>
        <label>unwanted advance</label>
        <description>They tried it on with me. I wasn't interested.</description>
        <baseMoodEffect>-3</baseMoodEffect>
        <baseOpinionOffset>-12</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>BrokeUpWithMe</defName>
    <durationDays>20</durationDays>
    <stackLimit>1</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages>
      <li>
        <label>broke up</label>
        <description>It's over between us.</description>
        <baseMoodEffect>-14</baseMoodEffect>
        <baseOpinionOffset>-25</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Divorced</defName>
    <durationDays>45</durationDays>
    <stackLimit>1</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages>
      <li>
        <label>divorced</label>
        <description>We were married. Now we are not.</description>
        <baseMoodEffect>-20</baseMoodEffect>
        <baseOpinionOffset>-40</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

</Defs>

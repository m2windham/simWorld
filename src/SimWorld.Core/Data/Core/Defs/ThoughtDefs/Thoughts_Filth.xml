<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    The mood cost of filth (system: filth). Its own file - situational thoughts are found by scanning every
    ThoughtDef that has a worker, so a new file and a new worker class is the whole wiring and nothing
    shared had to change (CLAUDE.md).

    See ThoughtWorker_FilthyRoom for why this reads room cleanliness directly instead of arriving through
    the Beauty need the way RimWorld's does: that need exists here but nothing implements the
    IEnvironmentSampler it reads through, so the beauty route is dormant end to end.

    The mood offsets are SimWorld's own. The filth tests pin that a dirtier room is a worse mood and that a
    clean room carries no thought at all, not these numbers.
  -->

  <ThoughtDef>
    <defName>FilthyRoom</defName>
    <workerClass>SimWorld.Filth.ThoughtWorker_FilthyRoom</workerClass>
    <stages>
      <li>
        <label>dirty room</label>
        <description>This place could do with a sweep.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
      <li>
        <label>filthy room</label>
        <description>I'm living in squalor.</description>
        <baseMoodEffect>-8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>

<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <TraitDef>
    <defName>Industriousness</defName>
    <label>work ethic</label>
    <commonality>1</commonality>
    <degreeDatas>
      <li>
        <label>tireless</label>
        <description>Works fast and tirelessly, throwing itself at whatever needs doing.</description>
        <degree>2</degree>
        <commonality>0.3</commonality>
      </li>
      <li>
        <label>diligent</label>
        <description>Gets more done than most, without complaint.</description>
        <degree>1</degree>
        <commonality>0.7</commonality>
      </li>
      <li>
        <label>lazy</label>
        <description>Drags its feet through every chore.</description>
        <degree>-1</degree>
        <commonality>0.6</commonality>
      </li>
    </degreeDatas>
  </TraitDef>

  <TraitDef>
    <defName>Brawler</defName>
    <label>scrapper</label>
    <commonality>0.3</commonality>
    <!-- As Bloodlust: recalled as RimWorld's own gate, not verified here. A pawn who cannot do violence at
         all has no business preferring to do it up close, and the melee skill bonus below would be dead
         weight on one. Pinned by behaviour over seeds. -->
    <requiredWorkTags>Violent</requiredWorkTags>
    <degreeDatas>
      <li>
        <label>scrapper</label>
        <description>Would much rather settle things with fists and blades than at range.</description>
        <degree>0</degree>
        <skillGains>
          <li>
            <skill>Melee</skill>
            <amount>4</amount>
          </li>
        </skillGains>
      </li>
    </degreeDatas>
  </TraitDef>

  <TraitDef>
    <defName>Tough</defName>
    <label>hardy</label>
    <commonality>0.4</commonality>
    <degreeDatas>
      <li>
        <label>hardy</label>
        <description>Shrugs off injuries that would floor most people.</description>
        <degree>0</degree>
      </li>
    </degreeDatas>
  </TraitDef>

  <TraitDef>
    <defName>Jealous</defName>
    <label>envious</label>
    <commonality>0.5</commonality>
    <degreeDatas>
      <li>
        <label>envious</label>
        <description>Keeps a close eye on what everyone else has, and resents it.</description>
        <degree>0</degree>
      </li>
    </degreeDatas>
  </TraitDef>

  <TraitDef>
    <defName>Greedy</defName>
    <label>grasping</label>
    <commonality>0.5</commonality>
    <degreeDatas>
      <li>
        <label>grasping</label>
        <description>Wants more of everything, and is not shy about saying so.</description>
        <degree>0</degree>
      </li>
    </degreeDatas>
  </TraitDef>

  <TraitDef>
    <defName>Abrasive</defName>
    <label>sharp-tongued</label>
    <commonality>0.6</commonality>
    <degreeDatas>
      <li>
        <label>sharp-tongued</label>
        <description>Blunt to the point of rudeness, whether it means to be or not.</description>
        <degree>0</degree>
        <!-- Recalled as RimWorld's own constant (a flat -15 to how everyone else sees this pawn) but not
             checked against decompiled source in this environment; pinned by a test asserting the sign and
             that it beats a plain compatibility swing, not the literal value. -->
        <opinionOffset>-15</opinionOffset>
      </li>
    </degreeDatas>
  </TraitDef>

  <TraitDef>
    <defName>Nimble</defName>
    <label>light-footed</label>
    <commonality>0.35</commonality>
    <degreeDatas>
      <li>
        <label>light-footed</label>
        <description>Light on its feet; slips out of the way of attacks more often than most.</description>
        <degree>0</degree>
      </li>
    </degreeDatas>
  </TraitDef>

  <TraitDef>
    <defName>FastLearner</defName>
    <label>quick study</label>
    <commonality>0.4</commonality>
    <exclusionTags>
      <li>learningSpeed</li>
    </exclusionTags>
    <degreeDatas>
      <li>
        <label>quick study</label>
        <description>Picks up new skills faster than most people manage.</description>
        <degree>0</degree>
      </li>
    </degreeDatas>
  </TraitDef>

  <TraitDef>
    <defName>SlowLearner</defName>
    <label>slow study</label>
    <commonality>0.4</commonality>
    <exclusionTags>
      <li>learningSpeed</li>
    </exclusionTags>
    <degreeDatas>
      <li>
        <label>slow study</label>
        <description>Takes longer than most to get the hang of anything new.</description>
        <degree>0</degree>
      </li>
    </degreeDatas>
  </TraitDef>

  <TraitDef>
    <defName>TooSmart</defName>
    <label>overclever</label>
    <commonality>0.3</commonality>
    <degreeDatas>
      <li>
        <label>overclever</label>
        <description>Sharp enough to learn quickly, and insufferable enough to mention it.</description>
        <degree>0</degree>
        <skillGains>
          <li>
            <skill>Intellectual</skill>
            <amount>3</amount>
          </li>
        </skillGains>
      </li>
    </degreeDatas>
  </TraitDef>

  <TraitDef>
    <defName>Gourmand</defName>
    <label>food-lover</label>
    <commonality>0.4</commonality>
    <degreeDatas>
      <li>
        <label>food-lover</label>
        <description>Lives to eat well, and has picked up real skill in the kitchen along the way.</description>
        <degree>0</degree>
        <skillGains>
          <li>
            <skill>Cooking</skill>
            <amount>2</amount>
          </li>
        </skillGains>
      </li>
    </degreeDatas>
  </TraitDef>

</Defs>

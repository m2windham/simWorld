<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <TraitDef>
    <defName>Pyromaniac</defName>
    <label>pyromaniac</label>
    <commonality>0.6</commonality>
    <disabledWorkTags>Firefighting</disabledWorkTags>
    <degreeDatas>
      <li>
        <label>pyromaniac</label>
        <description>Loves fire and is prone to starting it.</description>
        <degree>0</degree>
        <!-- RimWorld's own pairing: a pyromaniac's mood break is always the fire-starting spree and never
             anything else. Recalled from vanilla's Traits_Singular.xml rather than read off decompiled
             source here, so it is pinned by behaviour (a pyromaniac's possible breaks are exactly this one,
             and a pawn without the trait still has the ordinary spread) rather than by the list itself.

             The consequence is deliberate and worth knowing before adding to this list: MentalBreaker walks
             DOWN from the pawn's current intensity, so a pyromaniac in extreme despair finds no eligible
             extreme break, falls through to major, and burns something. A minor slump finds nothing at all
             below it and passes without a break. -->
        <theOnlyAllowedMentalBreaks>
          <li>FireStartingSpree</li>
        </theOnlyAllowedMentalBreaks>
      </li>
    </degreeDatas>
  </TraitDef>

  <TraitDef>
    <defName>Bloodlust</defName>
    <label>bloodlust</label>
    <commonality>0.6</commonality>
    <!-- Recalled as RimWorld's own gate on this trait, not verified against decompiled source in this
         environment: a pawn whose backstory, trait or germline has already barred violence never rolls a
         trait about enjoying it. Pinned by a test over many seeds (no violence-disabled pawn ever holds it),
         not by the literal tag. -->
    <requiredWorkTags>Violent</requiredWorkTags>
    <degreeDatas>
      <li>
        <label>bloodlust</label>
        <description>Enjoys violence and is not disturbed by death.</description>
        <degree>0</degree>
      </li>
    </degreeDatas>
  </TraitDef>

  <TraitDef>
    <defName>Psychopath</defName>
    <label>psychopath</label>
    <commonality>0.6</commonality>
    <conflictingTraits>
      <li>Kind</li>
    </conflictingTraits>
    <degreeDatas>
      <li>
        <label>psychopath</label>
        <description>Feels nothing for others.</description>
        <degree>0</degree>
      </li>
    </degreeDatas>
  </TraitDef>

  <TraitDef>
    <defName>Kind</defName>
    <label>kind</label>
    <commonality>1</commonality>
    <degreeDatas>
      <li>
        <label>kind</label>
        <description>Warm and considerate to others.</description>
        <degree>0</degree>
        <!-- Not sourced from RimWorld (vanilla's Kind trait has no direct opinion number); SimWorld's own
             choice, a positive counterpart to Abrasive's -15 sized to matter without dominating a relation or
             memory. Pinned by a test asserting Kind beats a plain pawn's opinion score, not the literal value. -->
        <opinionOffset>10</opinionOffset>
        <!-- Recalled as RimWorld's own (vanilla's Kind trait rules the insulting spree out); the sadistic
             rage is this port's own addition on the same reasoning — Kind does not conflict with Bloodlust,
             so a kind pawn can hold the trait that unlocks that break, and taking pleasure in another's pain
             is the one thing this trait says the pawn does not do. Unlike theOnlyAllowedMentalBreaks above
             this only narrows the spread, so a kind pawn still breaks; it just breaks in another way. -->
        <disallowedMentalBreaks>
          <li>InsultingSpree</li>
          <li>SadisticRage</li>
        </disallowedMentalBreaks>
      </li>
    </degreeDatas>
  </TraitDef>

  <TraitDef>
    <defName>Ascetic</defName>
    <label>ascetic</label>
    <commonality>0.8</commonality>
    <degreeDatas>
      <li>
        <label>ascetic</label>
        <description>Prefers a spartan life; fine food and rich surroundings hold no appeal.</description>
        <degree>0</degree>
      </li>
    </degreeDatas>
  </TraitDef>

</Defs>

<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- The only local map generator so far: a settlement's ordinary interior (spec §5b.5). -->

  <MapGeneratorDef>
    <defName>Base</defName>
    <genSteps>
      <li>ElevationFertility</li>
      <li>MapTerrain</li>
      <li>RocksAndMountains</li>
      <li>Caves</li>
      <li>Roofs</li>
      <li>Scatterers</li>
      <li>Ruins</li>
      <li>Roads</li>
      <!-- Last: the map has stopped changing shape, so nothing clears the ground under a living animal.
           Declared in its own GenSteps_Animals.xml; see SimWorld.MapGen.GenStep_Animals. -->
      <li>Animals</li>
    </genSteps>
  </MapGeneratorDef>

</Defs>

<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Everyday incidents. Some still use IncidentWorker_Placeholder: they validate and record that they fired,
    but their real effect (spawning a wanderer pawn, darkening the sky) belongs to systems that don't
    exist yet (see IncidentWorker_Placeholder's doc comment). HeatWave, ColdSnap and Flashstorm no longer do
    - they make real GameConditions (see Conditions/IncidentWorker_MakeGameCondition and the matching
    GameConditionDefs, which is where their duration lives). TraderCaravanArrival picks a real,
    non-hostile faction that can trade and generates it a real, priced stock (see
    IncidentWorker_TraderCaravanArrival) — actually walking a caravan onto the world map and opening a
    session at a specific settlement is Caravans/World's to build on top of that, see the worker's own doc.
  -->

  <IncidentDef>
    <defName>WandererJoin</defName>
    <label>wanderer joins</label>
    <description>A wanderer asks to join the civilization.</description>
    <category>Misc</category>
    <targetTags><li>Map_PlayerHome</li></targetTags>
    <workerClass>SimWorld.Director.IncidentWorker_WandererJoin</workerClass>
    <baseChance>1.0</baseChance>
    <minRefireDays>12</minRefireDays>
  </IncidentDef>

  <IncidentDef>
    <defName>TraderCaravanArrival</defName>
    <label>trade caravan arrives</label>
    <description>A trade caravan arrives to do business.</description>
    <category>FactionArrival</category>
    <targetTags><li>Map_PlayerHome</li></targetTags>
    <workerClass>SimWorld.Director.IncidentWorker_TraderCaravanArrival</workerClass>
    <baseChance>1.0</baseChance>
  </IncidentDef>

  <IncidentDef>
    <defName>VisitorGroup</defName>
    <label>visitors arrive</label>
    <description>A group of visitors arrives.</description>
    <category>FactionArrival</category>
    <targetTags><li>Map_PlayerHome</li></targetTags>
    <workerClass>SimWorld.Director.IncidentWorker_Placeholder</workerClass>
    <baseChance>0.5</baseChance>
  </IncidentDef>

  <IncidentDef>
    <defName>Eclipse</defName>
    <label>eclipse</label>
    <description>An eclipse darkens the sky.</description>
    <category>Misc</category>
    <targetTags><li>Map_PlayerHome</li></targetTags>
    <workerClass>SimWorld.Director.IncidentWorker_Placeholder</workerClass>
    <baseChance>0.3</baseChance>
    <earliestDay>15</earliestDay>
  </IncidentDef>

  <!--
    The one incident in this content that is genuinely era-bound: fallout is industrial-age wreckage, and
    nothing before the industrial era can produce it. minEra/maxEra exist for exactly this — the rest of
    these incidents (weather, disease, visitors) happen to a civilization in any age, and are deliberately
    left ungated rather than given invented eras.
  -->
  <IncidentDef>
    <defName>ToxicFallout</defName>
    <label>toxic fallout</label>
    <description>Toxic fallout blankets the area.</description>
    <category>Misc</category>
    <targetTags><li>Map_PlayerHome</li></targetTags>
    <workerClass>SimWorld.Director.IncidentWorker_Placeholder</workerClass>
    <baseChance>0.3</baseChance>
    <minEra>Industrial</minEra>
  </IncidentDef>

  <IncidentDef>
    <defName>HeatWave</defName>
    <label>heat wave</label>
    <description>A heat wave raises the temperature.</description>
    <category>Misc</category>
    <targetTags><li>Map_PlayerHome</li></targetTags>
    <workerClass>SimWorld.Conditions.IncidentWorker_MakeGameCondition</workerClass>
    <baseChance>0.5</baseChance>
    <minRefireDays>15</minRefireDays>
  </IncidentDef>

  <IncidentDef>
    <defName>ColdSnap</defName>
    <label>cold snap</label>
    <description>A cold snap drops the temperature.</description>
    <category>Misc</category>
    <targetTags><li>Map_PlayerHome</li></targetTags>
    <workerClass>SimWorld.Conditions.IncidentWorker_MakeGameCondition</workerClass>
    <baseChance>0.5</baseChance>
    <minRefireDays>15</minRefireDays>
  </IncidentDef>

  <IncidentDef>
    <defName>Flashstorm</defName>
    <label>flashstorm</label>
    <description>A flashstorm brings sudden lightning.</description>
    <category>Misc</category>
    <targetTags><li>Map_PlayerHome</li></targetTags>
    <workerClass>SimWorld.Conditions.IncidentWorker_MakeGameCondition</workerClass>
    <baseChance>0.3</baseChance>
    <minRefireDays>10</minRefireDays>
  </IncidentDef>

</Defs>

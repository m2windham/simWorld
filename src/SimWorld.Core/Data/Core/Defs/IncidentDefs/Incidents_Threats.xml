<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Big, point-scaled threats. RaidEnemy's squad composition/tactic (points and tech spent against the
    raiding faction's own PawnGroupMakers/RaidStrategyDefs) lives in IncidentWorker_RaidEnemy; see that
    class's doc comment for exactly how far it goes without a Map to place the squad on. ManhunterPack has
    no such system yet, so it still uses the points-validating placeholder.
  -->

  <IncidentDef>
    <defName>RaidEnemy</defName>
    <label>raid</label>
    <description>Hostiles attack the civilization.</description>
    <category>ThreatBig</category>
    <targetTags><li>Map_PlayerHome</li></targetTags>
    <workerClass>SimWorld.Director.IncidentWorker_RaidEnemy</workerClass>
    <baseChance>1.0</baseChance>
    <minThreatPoints>35</minThreatPoints>
    <pointsScaleable>true</pointsScaleable>
  </IncidentDef>

  <IncidentDef>
    <defName>ManhunterPack</defName>
    <label>manhunter pack</label>
    <description>A pack of animals turns manhunter and attacks the civilization.</description>
    <category>ThreatBig</category>
    <targetTags><li>Map_PlayerHome</li></targetTags>
    <workerClass>SimWorld.Director.IncidentWorker_ThreatEvent</workerClass>
    <baseChance>0.5</baseChance>
    <minThreatPoints>35</minThreatPoints>
    <pointsScaleable>true</pointsScaleable>
  </IncidentDef>

</Defs>

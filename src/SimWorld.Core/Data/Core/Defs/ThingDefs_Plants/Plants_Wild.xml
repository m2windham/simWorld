<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Wild vegetation, scattered onto a generated map by MapGen.GenStep_Scatterers (spec §5). Now a real
    Building.Plant (system 16: Building — plant growth landed) — it grows on the long tick from fertility ×
    light × temperature like any other plant — but it spawns already fully established (Plant.PostMake's own
    default) rather than a fresh seedling, since it represents pre-existing scrub rather than something a
    colonist just sowed; and it carries no harvestedThingDef, so WorkGiver_GrowerHarvest never targets it —
    still flavor/occupancy dressing, just dressing with a real growth mechanism behind it now.
  -->

  <ThingDef>
    <defName>WildPlant</defName>
    <label>wild plant growth</label>
    <description>Undergrowth and scrub, as thick as the local biome allows.</description>
    <category>Plant</category>
    <thingClass>SimWorld.Building.Plant</thingClass>
    <tickerType>Long</tickerType>
    <passability>Standable</passability>
    <useHitPoints>true</useHitPoints>
    <destroyable>true</destroyable>
    <selectable>false</selectable>
    <statBases>
      <MaxHitPoints>40</MaxHitPoints>
    </statBases>
    <plant>
      <growDays>5</growDays>
    </plant>
  </ThingDef>

</Defs>

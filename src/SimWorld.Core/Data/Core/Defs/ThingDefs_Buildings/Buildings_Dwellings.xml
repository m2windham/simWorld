<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Dwellings (building.initiative): one building a household sleeps in (SimWorld.Building.Dwelling). Not a
    RimWorld port; RimWorld has no house. See that class for why a dwelling is the bed source for its
    household rather than a box with beds in it.

    The defNames are the host's art families (simWorld.Host Assets/Resources/Models/House_<Era>_a..d), so
    the host resolves them with no mapping of its own. The ladder is read off research, not off a new era
    field: each rung names the project that opens it, and Building.DwellingUtility.PreferredDwellingDef takes
    the newest rung the civilization has finished.

      House_Paleo   no prerequisite      SticksAndStones; a founding band can always build one
      House_Meso    PitDwellings         SticksAndStones ("a dug floor and a timber roof")
      House_Neo     Shelter              Agrarian ("framed walls and a roof: the first buildings meant to last")
      House_Chalco  Copper               Bronze, the first project of the metal age

    Size is the art's: 4x5 cells, authored front toward -Z at rotation North, so a dwelling turned North
    opens to the south. Four cells of width is four sleeping slots (AI.BedUtility, RimWorld's rule: one per
    cell of width), which is a founding couple and two children.

    Standable like a bed, so its household can walk in and lie down; pathCost keeps through traffic round it.
    fillPercent 0, so RoomTracker never reads a house as twenty cells of wall. WorkToBuild, costList,
    MaxHitPoints and pathCost are SimWorld's own figures, unsourced: a Paleo hut costs about five beds of
    wood, and each rung costs more and takes longer. Tests pin what they produce, not the literals.
  -->

  <ThingDef Name="DwellingBase" Abstract="True">
    <category>Building</category>
    <thingClass>SimWorld.Building.Dwelling</thingClass>
    <size>(4,5)</size>
    <passability>Standable</passability>
    <pathCost>30</pathCost>
    <fillPercent>0</fillPercent>
  </ThingDef>

  <ThingDef ParentName="DwellingBase">
    <defName>House_Paleo</defName>
    <label>hut</label>
    <description>Branches and hide over a frame of poles: a household's own place to sleep.</description>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>1000</WorkToBuild>
      <BedRestEffectiveness>1.07</BedRestEffectiveness>
    </statBases>
    <costList>
      <WoodLog>40</WoodLog>
    </costList>
  </ThingDef>

  <ThingDef ParentName="DwellingBase">
    <defName>House_Meso</defName>
    <label>pit house</label>
    <description>A dug floor under a timber roof: a household's home that shrugs off the wind.</description>
    <statBases>
      <MaxHitPoints>350</MaxHitPoints>
      <WorkToBuild>1400</WorkToBuild>
      <BedRestEffectiveness>1.07</BedRestEffectiveness>
    </statBases>
    <costList>
      <WoodLog>50</WoodLog>
    </costList>
    <researchPrerequisites>
      <li>PitDwellings</li>
    </researchPrerequisites>
  </ThingDef>

  <ThingDef ParentName="DwellingBase">
    <defName>House_Neo</defName>
    <label>longhouse</label>
    <description>Framed walls and a thatched roof: a household's home built to last.</description>
    <statBases>
      <MaxHitPoints>400</MaxHitPoints>
      <WorkToBuild>1800</WorkToBuild>
      <BedRestEffectiveness>1.07</BedRestEffectiveness>
    </statBases>
    <costList>
      <WoodLog>60</WoodLog>
    </costList>
    <researchPrerequisites>
      <li>Shelter</li>
    </researchPrerequisites>
  </ThingDef>

  <ThingDef ParentName="DwellingBase">
    <defName>House_Chalco</defName>
    <label>town house</label>
    <description>Mud brick on a timber frame: a household's home in a town that works copper.</description>
    <statBases>
      <MaxHitPoints>450</MaxHitPoints>
      <WorkToBuild>2200</WorkToBuild>
      <BedRestEffectiveness>1.07</BedRestEffectiveness>
    </statBases>
    <costList>
      <WoodLog>70</WoodLog>
    </costList>
    <researchPrerequisites>
      <li>Copper</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- Blueprints and frames: no size of their own, read off entityToBuild (Thing.Size). A frame copies its
       building's passability, fillPercent and pathCost, as Buildings_BlueprintsAndFrames.xml's do. -->

  <ThingDef Name="DwellingBlueprintBase" Abstract="True">
    <category>Blueprint</category>
    <thingClass>SimWorld.Building.Blueprint</thingClass>
    <passability>Standable</passability>
  </ThingDef>

  <ThingDef Name="DwellingFrameBase" Abstract="True">
    <category>Frame</category>
    <thingClass>SimWorld.Building.Frame</thingClass>
    <passability>Standable</passability>
    <pathCost>30</pathCost>
    <fillPercent>0</fillPercent>
  </ThingDef>

  <ThingDef ParentName="DwellingBlueprintBase">
    <defName>Blueprint_House_Paleo</defName>
    <label>hut (blueprint)</label>
    <entityToBuild>House_Paleo</entityToBuild>
  </ThingDef>

  <ThingDef ParentName="DwellingFrameBase">
    <defName>Frame_House_Paleo</defName>
    <label>hut (under construction)</label>
    <entityToBuild>House_Paleo</entityToBuild>
  </ThingDef>

  <ThingDef ParentName="DwellingBlueprintBase">
    <defName>Blueprint_House_Meso</defName>
    <label>pit house (blueprint)</label>
    <entityToBuild>House_Meso</entityToBuild>
  </ThingDef>

  <ThingDef ParentName="DwellingFrameBase">
    <defName>Frame_House_Meso</defName>
    <label>pit house (under construction)</label>
    <entityToBuild>House_Meso</entityToBuild>
  </ThingDef>

  <ThingDef ParentName="DwellingBlueprintBase">
    <defName>Blueprint_House_Neo</defName>
    <label>longhouse (blueprint)</label>
    <entityToBuild>House_Neo</entityToBuild>
  </ThingDef>

  <ThingDef ParentName="DwellingFrameBase">
    <defName>Frame_House_Neo</defName>
    <label>longhouse (under construction)</label>
    <entityToBuild>House_Neo</entityToBuild>
  </ThingDef>

  <ThingDef ParentName="DwellingBlueprintBase">
    <defName>Blueprint_House_Chalco</defName>
    <label>town house (blueprint)</label>
    <entityToBuild>House_Chalco</entityToBuild>
  </ThingDef>

  <ThingDef ParentName="DwellingFrameBase">
    <defName>Frame_House_Chalco</defName>
    <label>town house (under construction)</label>
    <entityToBuild>House_Chalco</entityToBuild>
  </ThingDef>

</Defs>

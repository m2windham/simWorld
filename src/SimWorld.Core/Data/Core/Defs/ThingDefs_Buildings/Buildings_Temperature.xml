<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- RimWorld 1.0 Core/Defs/ThingDefs_Buildings/Buildings_Temperature.xml: PassiveCooler, every simulated
       field as RimWorld ships it. Not carried: graphics, sounds, the designation category and hotkey, and
       PlaceWorker_CoolerSimple (it only draws the room the cooler would cool). RimWorld's comp class
       Verse.CompHeatPusherPowered is SimWorld.Building.CompHeatPusherGated here: the port's
       CompHeatPusherPowered is the heater's own flat push.
       Translations (shelter lane): RimWorld gates it on its PassiveCooler project, a Neolithic root; here it
       waits for Windcatchers, the Bronze age's, because a settlement that lives dug into the earth does not
       need one and one that builds above ground does. And it carries RimWorld's CompFlickable, which RimWorld's
       passive cooler does not, so a settlement can stop it drinking wood out of season: RimWorld's
       CompRefuelable stops burning and refuelling while a flickable is switched off. -->

  <ThingDef>
    <defName>PassiveCooler</defName>
    <label>clay cooler</label>
    <description>A traditional unpowered cooler that works by water evaporation. Must be regularly replenished with wood. Not efficient enough to refrigerate food.</description>
    <category>Building</category>
    <thingClass>SimWorld.Building.Building</thingClass>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <tickerType>Normal</tickerType>
    <fillPercent>0.40</fillPercent>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>200</WorkToBuild>
      <Flammability>1</Flammability>
    </statBases>
    <costList>
      <WoodLog>50</WoodLog>
    </costList>
    <comps>
      <li Class="SimWorld.Building.CompProperties_HeatPusher">
        <compClass>SimWorld.Building.CompHeatPusherGated</compClass>
        <heatPerSecond>-11</heatPerSecond>
        <heatPushMinTemperature>17</heatPushMinTemperature>
      </li>
      <li Class="SimWorld.Building.CompProperties_Refuelable">
        <fuelConsumptionRate>10.0</fuelConsumptionRate>
        <fuelCapacity>50.0</fuelCapacity>
        <fuelFilter>
          <thingDefs>
            <li>WoodLog</li>
          </thingDefs>
        </fuelFilter>
        <initialFuelPercent>1</initialFuelPercent>
      </li>
      <li Class="SimWorld.Building.CompProperties_Flickable" />
    </comps>
    <researchPrerequisites>
      <li>Windcatchers</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- Its blueprint and frame, hand-authored as Buildings_BlueprintsAndFrames.xml explains; the frame copies
       the cooler's passability, fill and path cost. -->

  <ThingDef>
    <defName>Blueprint_PassiveCooler</defName>
    <label>clay cooler (blueprint)</label>
    <category>Blueprint</category>
    <thingClass>SimWorld.Building.Blueprint</thingClass>
    <passability>Standable</passability>
    <entityToBuild>PassiveCooler</entityToBuild>
  </ThingDef>

  <ThingDef>
    <defName>Frame_PassiveCooler</defName>
    <label>clay cooler (under construction)</label>
    <category>Frame</category>
    <thingClass>SimWorld.Building.Frame</thingClass>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.40</fillPercent>
    <entityToBuild>PassiveCooler</entityToBuild>
  </ThingDef>

</Defs>

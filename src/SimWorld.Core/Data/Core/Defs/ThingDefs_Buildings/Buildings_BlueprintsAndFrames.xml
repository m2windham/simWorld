<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    One Blueprint/Frame ThingDef pair per buildable Def above (system 16: Building) — hand-authored rather
    than generated; see ThingDef.entityToBuild's own remarks for why. A Blueprint is always Standable/no
    fill (it never touches the edifice grid at all); a Frame copies its entityToBuild's passability/fillPercent/
    pathCost so a half-built wall already blocks movement and room flood fill exactly like the finished
    wall would — Frame.SpawnSetup registers it into the edifice grid manually since its own category is
    Frame, not Building, so ThingDef.IsEdifice's generic check never fires for it on its own.
  -->

  <ThingDef>
    <defName>Blueprint_Wall</defName>
    <label>wall (blueprint)</label>
    <category>Blueprint</category>
    <thingClass>SimWorld.Building.Blueprint</thingClass>
    <passability>Standable</passability>
    <entityToBuild>Wall</entityToBuild>
  </ThingDef>

  <ThingDef>
    <defName>Frame_Wall</defName>
    <label>wall (under construction)</label>
    <category>Frame</category>
    <thingClass>SimWorld.Building.Frame</thingClass>
    <passability>Impassable</passability>
    <fillPercent>1</fillPercent>
    <pathCost>10000</pathCost>
    <entityToBuild>Wall</entityToBuild>
  </ThingDef>


<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Walls and doors (system 16: Building). Ungated by research — a wood/stone wall is not a technology any
    more than a club is (see research.unlocks-content's own note on the club). Costed in wood, the material
    every settlement starts able to gather.
  -->

  <ThingDef>
    <defName>Wall</defName>
    <label>wall</label>
    <description>A solid wall, providing structure and insulation.</description>
    <category>Building</category>
    <thingClass>SimWorld.Building.Building</thingClass>
    <passability>Impassable</passability>
    <fillPercent>1</fillPercent>
    <pathCost>10000</pathCost>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <Insulation>100</Insulation>
    </statBases>
    <costList>
      <WoodLog>5</WoodLog>
    </costList>
  </ThingDef>

  <ThingDef>
    <defName>Door</defName>
    <label>door</label>
    <description>A doorway through a wall.</description>
    <category>Building</category>
    <thingClass>SimWorld.Building.Door</thingClass>
    <!--
      Deviation (see SimWorld.Building.Door's own remarks): real RimWorld doors swing open for an
      approaching pawn and are otherwise impassable; this pass's Door is always Standable (open) — no swing
      state, no faction-allowed check. fillPercent stays 1 so RoomTracker still treats it as a room boundary
      (a doorway still separates two Rooms; RoomGroup re-merges them thermally) even though it never blocks
      movement.
    -->
    <passability>Standable</passability>
    <fillPercent>1</fillPercent>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <Insulation>1</Insulation>
    </statBases>
    <costList>
      <WoodLog>4</WoodLog>
    </costList>
  </ThingDef>

  <!--
    Bed and StorageHut (building.initiative — SettlementConstructionInitiative's own buildable Defs): what a
    settlement decides for itself it needs, not player-designed content. Ungated by research and wood-costed
    like Wall/Door above, for the same reason. WorkToBuild/MaxHitPoints/costList are SimWorld's own figures —
    RimWorld's real bed/storage-structure costs were not sourceable from this sandbox — chosen to sit between
    Door and Heater in effort; pinned by ConstructionInitiativeTests' end-to-end build rather than trusted as
    a literal (CLAUDE.md's own rule for untraceable numbers).

    Bed is deliberately not wired into Need_Rest/JobGiver_GetRest (AI/**, out of this lane's reach): a citizen
    does not yet actually sleep in the bed this system builds for them — every pawn still sleeps on the ground
    per JobGiver_GetRest's own doc. This system only answers "does the settlement have a physical bed for each
    of its people" — the physical-presence half of that gap. Wiring real bed use into the Rest need is
    JobGiver_GetRest's own next step, not this one.
  -->

  <ThingDef>
    <defName>Bed</defName>
    <label>bed</label>
    <description>A simple sleeping pallet. Every settler wants one of their own.</description>
    <category>Building</category>
    <thingClass>SimWorld.Building.Building</thingClass>
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>180</WorkToBuild>
    </statBases>
    <costList>
      <WoodLog>8</WoodLog>
    </costList>
  </ThingDef>

  <ThingDef>
    <defName>StorageHut</defName>
    <label>storage hut</label>
    <description>A roofed hut for keeping goods out of the weather.</description>
    <category>Building</category>
    <thingClass>SimWorld.Building.Building</thingClass>
    <passability>Impassable</passability>
    <fillPercent>0</fillPercent>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>320</WorkToBuild>
    </statBases>
    <costList>
      <WoodLog>25</WoodLog>
    </costList>
  </ThingDef>

</Defs>

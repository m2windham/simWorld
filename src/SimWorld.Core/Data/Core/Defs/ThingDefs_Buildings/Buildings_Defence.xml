<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Blueprint/Frame pairs for the traps a settlement now lays for itself (system: combat, Defence.SettlementDefence).
    The traps themselves (Buildings_Security.xml) shipped with no blueprint, so nothing could ever build one. Own
    file, per CLAUDE.md. A trap's frame is Standable with no fill, like the trap.
  -->

  <ThingDef>
    <defName>Blueprint_TrapSpike</defName>
    <label>spike trap (blueprint)</label>
    <category>Blueprint</category>
    <thingClass>SimWorld.Building.Blueprint</thingClass>
    <passability>Standable</passability>
    <entityToBuild>TrapSpike</entityToBuild>
  </ThingDef>

  <ThingDef>
    <defName>Frame_TrapSpike</defName>
    <label>spike trap (under construction)</label>
    <category>Frame</category>
    <thingClass>SimWorld.Building.Frame</thingClass>
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <entityToBuild>TrapSpike</entityToBuild>
  </ThingDef>

  <ThingDef>
    <defName>Blueprint_TrapIED</defName>
    <label>IED trap (blueprint)</label>
    <category>Blueprint</category>
    <thingClass>SimWorld.Building.Blueprint</thingClass>
    <passability>Standable</passability>
    <entityToBuild>TrapIED</entityToBuild>
  </ThingDef>

  <ThingDef>
    <defName>Frame_TrapIED</defName>
    <label>IED trap (under construction)</label>
    <category>Frame</category>
    <thingClass>SimWorld.Building.Frame</thingClass>
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <entityToBuild>TrapIED</entityToBuild>
  </ThingDef>

</Defs>
